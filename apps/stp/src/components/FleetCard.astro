---
import type { FleetItem } from "../types/fleet";
import { equipmentWhatsappMessage, whatsappUrl } from "../data/site";
import FleetImage from "./FleetImage.astro";

interface Props {
  item: FleetItem;
}

const { item } = Astro.props;
const hireType = item.rates.operatorCostIncluded ? "Wet hire" : "Dry hire";
const waHref = whatsappUrl(equipmentWhatsappMessage(item.title, item.slug));
---

<article
  class="fleet-card flex flex-col overflow-hidden rounded-xl border border-white/10 bg-slate/80"
  data-category={item.category}
>
  <FleetImage src={item.primaryImage} title={item.title} />
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-green-500/20 px-2.5 py-0.5 text-xs font-medium text-green-300">
        Available Now
      </span>
      <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs text-neutral-300">
        {hireType}
      </span>
    </div>
    <div>
      <h3 class="text-lg font-semibold text-white">
        <a href={`/plant-hire/${item.slug}`} class="hover:text-safety">
          {item.title}
        </a>
      </h3>
      <p class="mt-2 text-sm text-neutral-400">{item.shortDescription}</p>
      <p class="mt-2 text-sm font-medium text-safety">{item.rates.indicator}</p>
    </div>
    <div class="mt-auto flex flex-wrap gap-2">
      <a
        href={`/plant-hire/${item.slug}`}
        class="rounded-lg bg-safety px-4 py-2 text-sm font-semibold text-charcoal hover:bg-safety-hover"
      >
        View specs
      </a>
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/5"
      >
        WhatsApp
      </a>
    </div>
  </div>
</article>
