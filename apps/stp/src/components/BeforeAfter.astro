---
interface Props {
  title: string;
  description?: string;
  beforeSrc?: string;
  afterSrc?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  title,
  description,
  beforeSrc,
  afterSrc,
  beforeLabel = "Before",
  afterLabel = "After",
} = Astro.props;
---

<article class="rounded-xl border border-white/10 bg-slate/80 overflow-hidden">
  <div class="grid grid-cols-2 divide-x divide-white/10">
    <!-- Before -->
    <div class="relative">
      <div class="aspect-[4/3] bg-gradient-to-br from-slate to-charcoal flex items-center justify-center">
        {beforeSrc
          ? <img src={beforeSrc} alt={`${title} — ${beforeLabel}`} class="h-full w-full object-cover" loading="lazy" />
          : <div class="flex flex-col items-center gap-2 p-6 text-center">
              <svg class="h-12 w-12 text-neutral-500 opacity-30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
              </svg>
              <p class="text-sm font-medium text-neutral-400">{title}</p>
              <p class="text-xs text-neutral-500">Photo coming soon</p>
            </div>
        }
      </div>
      <span class="absolute top-3 left-3 rounded-full bg-amber-500/90 px-3 py-1 text-xs font-bold text-charcoal uppercase tracking-wider">
        {beforeLabel}
      </span>
    </div>
    <!-- After -->
    <div class="relative">
      <div class="aspect-[4/3] bg-gradient-to-br from-slate to-charcoal flex items-center justify-center">
        {afterSrc
          ? <img src={afterSrc} alt={`${title} — ${afterLabel}`} class="h-full w-full object-cover" loading="lazy" />
          : <div class="flex flex-col items-center gap-2 p-6 text-center">
              <svg class="h-12 w-12 text-green-400 opacity-40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
              </svg>
              <p class="text-sm font-medium text-neutral-400">{title}</p>
              <p class="text-xs text-green-400/60">Completed result</p>
            </div>
        }
      </div>
      <span class="absolute top-3 left-3 rounded-full bg-green-500/90 px-3 py-1 text-xs font-bold text-charcoal uppercase tracking-wider">
        {afterLabel}
      </span>
    </div>
  </div>
  {description && (
    <div class="border-t border-white/10 px-5 py-4">
      <p class="text-sm text-neutral-400">{description}</p>
    </div>
  )}
</article>
