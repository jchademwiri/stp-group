---
const badges = [
  "Qualified Operators Included (TETA / SAMA certified)",
  "Public Liability Insured",
  "COIDA Registered",
  "CIDB Registered: Grades 6 CE, 6 EP, 6 SH, 5 GB, 4 SK",
];
---

<ul class="flex flex-wrap gap-2" role="list">
  {
    badges.map((badge) => (
      <li class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-neutral-200">
        {badge}
      </li>
    ))
  }
</ul>
