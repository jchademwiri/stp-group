---
const badges = [
  "CIDB 6CE",
  "CIDB 6EP",
  "CIDB 6SH",
  "CIDB 5GB",
  "CIDB 4SK",
  "COIDA",
  "Public Liability",
] as const;
---

<div class="flex flex-wrap gap-2">
  {
    badges.map((badge) => (
      <span class="flex items-center gap-1.5 rounded-full border border-ink/15 bg-ink/10 px-3 py-1.5 text-xs font-medium text-ink/80">
        <svg
          class="h-3.5 w-3.5 shrink-0 text-brand"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        {badge}
      </span>
    ))
  }
</div>
