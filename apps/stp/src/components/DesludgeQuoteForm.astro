---
import { SITE } from "@/data/site";

const serviceOptions = [
  "Septic Tank Emptying",
  "Toilet / Pit Latrine Desludging",
  "Grease Trap Cleaning",
  "Industrial Liquid Waste Removal",
  "Emergency Blocked Drain",
];

const tankSizeOptions = [
  "Small (under 2,000 L)",
  "Medium (2,000 – 5,000 L)",
  "Large (5,000 – 10,000 L)",
  "Industrial (10,000 L+)",
  "Not sure",
];
---

<div class="rounded-2xl border border-white/10 bg-slate p-6 md:p-10">
  <h2 class="text-2xl font-bold text-white">Request a Desludging Quote</h2>
  <p class="mt-2 text-neutral-400">
    Tell us about your site - we'll respond {SITE.responseTime}.
  </p>

  <form id="desludge-quote-form" class="mt-6">
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <p class="mb-4 text-sm text-neutral-400">
      Step <span data-step-current>1</span> of 2
    </p>

    <div class="grid gap-4 md:grid-cols-2" data-step-panel="1">
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="font-medium text-neutral-200">Your Full Name *</span>
        <input type="text" name="name" required autocomplete="name" class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white" />
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="font-medium text-neutral-200">Email *</span>
        <input type="email" name="email" required autocomplete="email" class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white" />
      </label>
      <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
        <span class="font-medium text-neutral-200">Phone *</span>
        <input type="tel" name="phone" required autocomplete="tel" class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white" />
      </label>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-2" data-step-panel="2" hidden>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="font-medium text-neutral-200">Service needed *</span>
        <select name="service" required class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white">
          <option value="">Select service</option>
          {serviceOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="font-medium text-neutral-200">Tank / pit size</span>
        <select name="tankSize" class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white">
          <option value="">Select size</option>
          {tankSizeOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
        <span class="font-medium text-neutral-200">Site location *</span>
        <input type="text" name="location" required class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white" placeholder="City / suburb / estate" />
      </label>
      <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
        <span class="font-medium text-neutral-200">Message (optional)</span>
        <textarea name="message" rows={3} class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white" placeholder="Access details, urgency, number of toilets / units…"></textarea>
      </label>
    </div>

    <p class="mt-4 text-xs text-neutral-500">
      By submitting, you agree we may contact you about this inquiry. We process data in line with POPIA.
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <button type="button" data-step-back hidden class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/5">Back</button>
      <button type="button" data-step-next class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover">Next</button>
      <button type="submit" data-step-submit hidden class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover disabled:opacity-60">Send inquiry</button>
    </div>
    <p id="desludge-form-status" class="mt-3 hidden text-sm" role="status"></p>
  </form>
</div>

<script>
  import { initFormSteps } from "@/scripts/form-steps";
  import { setFormStatus, submitQuote } from "@/scripts/submit-quote";
  import { initFormPersistence, initInlineValidation, clearFormPersistence } from "@/scripts/form-utils";

  initFormSteps("desludge-quote-form");
  initFormPersistence("desludge-quote-form");
  initInlineValidation("desludge-quote-form");

  const form = document.getElementById("desludge-quote-form") as HTMLFormElement | null;
  const status = document.getElementById("desludge-form-status");
  const submitBtn = form?.querySelector("[data-step-submit]") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    const fd = new FormData(form);
    setFormStatus(status, "Sending…", "pending");
    const originalBtnText = submitBtn?.innerHTML ?? "";
    if (submitBtn) {
      submitBtn.innerHTML =
        '<span class="flex items-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>Sending…</span>';
    }
    submitBtn?.setAttribute("disabled", "true");

    const result = await submitQuote({
      type: "desludging",
      name: String(fd.get("name") ?? ""),
      email: String(fd.get("email") ?? ""),
      phone: String(fd.get("phone") ?? ""),
      location: String(fd.get("location") ?? "") || undefined,
      service: String(fd.get("service") ?? "") || undefined,
      tankSize: String(fd.get("tankSize") ?? "") || undefined,
      message: String(fd.get("message") ?? "") || undefined,
      website: String(fd.get("website") ?? ""),
    });

    if (submitBtn) submitBtn.innerHTML = originalBtnText;
    submitBtn?.removeAttribute("disabled");

    if (result.ok) {
      setFormStatus(status, "Thank you - we'll respond soon.", "success");
      clearFormPersistence("desludge-quote-form");
      form.reset();
      return;
    }

    setFormStatus(status, result.message, "error");
  });
</script>
