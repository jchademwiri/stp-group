---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  title: string;
  client: string;
  description: string;
  stats: Stat[];
  imageSrc?: string;
  imageAlt?: string;
}

const { title, client, description, stats, imageSrc, imageAlt = title } = Astro.props;
---

<article class="rounded-xl border border-white/10 bg-slate/80 overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:border-white/20 hover:shadow-lg hover:shadow-black/30">
  {imageSrc
    ? <img src={imageSrc} alt={imageAlt} class="aspect-[16/7] w-full object-cover" loading="lazy" />
    : <div class="aspect-[16/7] bg-gradient-to-br from-slate to-charcoal flex items-center justify-center">
        <div class="flex flex-col items-center gap-2 p-4 text-center">
          <svg class="h-10 w-10 text-neutral-500 opacity-30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
          </svg>
          <p class="text-xs text-neutral-500">Project image</p>
        </div>
      </div>
  }
  <div class="p-5">
    <p class="text-xs font-medium tracking-wider text-brand uppercase">{client}</p>
    <h3 class="mt-1 text-lg font-semibold text-white">{title}</h3>
    <p class="mt-2 text-sm text-neutral-400">{description}</p>
    <div class="mt-4 flex flex-col gap-2">
      {stats.map((stat) => (
        <div class="rounded-lg border border-white/10 bg-charcoal/60 px-4 py-3">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm text-neutral-400">{stat.label}</p>
            <p class="text-sm font-bold text-brand whitespace-nowrap">{stat.value}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</article>
