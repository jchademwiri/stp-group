---
import { plantFleet } from "@/data/plantFleet";
import { SITE } from "@/data/site";

interface Props {
  selectedEquipment?: string;
}

const { selectedEquipment = "" } = Astro.props;
const durations = ["1-3 Days", "4-7 Days", "1 Month+", "Long-term Contract"];
---

<section id="quote-form" class="scroll-mt-8 rounded-2xl border border-white/10 bg-slate p-6 md:p-10">
  <h2 class="text-2xl font-bold text-white">Need a Fast Plant Hire Quote?</h2>
  <p class="mt-2 text-neutral-400">
    Fill out the details below and our team will get back to you {SITE.responseTime}.
  </p>

  <form id="hire-quote-form" class="mt-6 grid gap-4 md:grid-cols-2">
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Your Full Name *</span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Your Full Name"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Your Email Address *</span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Your Email Address"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Your Contact Number *</span>
      <input
        type="tel"
        name="phone"
        required
        autocomplete="tel"
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Your Contact Number"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Equipment Needed *</span>
      <select
        name="equipment"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
      >
        <option value="">Select equipment</option>
        {
          plantFleet.map((item) => (
            <option value={item.title} selected={item.title === selectedEquipment}>
              {item.title}
            </option>
          ))
        }
      </select>
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Rental Start Date</span>
      <input
        type="date"
        name="startDate"
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Rental Duration *</span>
      <select
        name="duration"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
      >
        <option value="">Select duration</option>
        {durations.map((d) => <option value={d}>{d}</option>)}
      </select>
    </label>

    <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
      <span class="font-medium text-neutral-200">Site Location *</span>
      <input
        type="text"
        name="location"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Where should the equipment be delivered?"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
      <span class="font-medium text-neutral-200">Message (optional)</span>
      <textarea
        name="message"
        rows={4}
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Describe your project requirements..."
      ></textarea>
    </label>

    <p class="text-xs text-neutral-500 md:col-span-2">
      By submitting, you agree we may contact you about this inquiry. We process data in line with POPIA.
    </p>

    <div class="md:col-span-2">
      <button
        type="submit"
        class="w-full rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover disabled:opacity-60 md:w-auto"
      >
        Send Hire Inquiry
      </button>
      <p id="hire-form-status" class="mt-3 hidden text-sm" role="status"></p>
    </div>
  </form>
</section>

<script>
  import { setFormStatus, submitQuote } from "@/scripts/submit-quote";

  const form = document.getElementById("hire-quote-form") as HTMLFormElement | null;
  const status = document.getElementById("hire-form-status");
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    const fd = new FormData(form);
    setFormStatus(status, "Sending…", "pending");
    submitBtn?.setAttribute("disabled", "true");

    const result = await submitQuote({
      type: "plant-hire",
      name: String(fd.get("name") ?? ""),
      email: String(fd.get("email") ?? ""),
      phone: String(fd.get("phone") ?? ""),
      equipment: String(fd.get("equipment") ?? ""),
      duration: String(fd.get("duration") ?? ""),
      location: String(fd.get("location") ?? ""),
      startDate: String(fd.get("startDate") ?? "") || undefined,
      message: String(fd.get("message") ?? "") || undefined,
      website: String(fd.get("website") ?? ""),
    });

    submitBtn?.removeAttribute("disabled");

    if (result.ok) {
      setFormStatus(status, "Thank you — we'll respond soon.", "success");
      form.reset();
      return;
    }

    setFormStatus(status, result.message, "error");
  });
</script>
