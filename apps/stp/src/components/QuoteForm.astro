---
import { plantFleet } from "@/data/plantFleet";
import { SITE } from "@/data/site";

interface Props {
  selectedEquipment?: string;
}

const { selectedEquipment = "" } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const durations = ["1-3 Days", "4-7 Days", "1 Month+", "Long-term Contract"];
---

<section id="quote-form" class="scroll-mt-8 rounded-2xl border border-white/10 bg-slate p-6 md:p-10">
  <h2 class="text-2xl font-bold text-white">Need a Fast Plant Hire Quote?</h2>
  <p class="mt-2 text-neutral-400">
    Fill out the details below and our team will get back to you {SITE.responseTime}.
  </p>

  {
    !accessKey && (
      <p class="mt-4 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
        Form delivery is not configured yet. Set <code class="text-safety">PUBLIC_WEB3FORMS_ACCESS_KEY</code> in
        <code class="text-safety"> apps/stp/.env</code> or use Call / WhatsApp below.
      </p>
    )
  }

  <form
    id="hire-quote-form"
    class="mt-6 grid gap-4 md:grid-cols-2"
    data-access-key={accessKey}
    data-fallback-email={SITE.email}
  >
    {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
    <input type="hidden" name="subject" value="New Plant Hire Inquiry" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Your Full Name *</span>
      <input
        type="text"
        name="name"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Your Full Name"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Your Email Address *</span>
      <input
        type="email"
        name="email"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Your Email Address"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Your Contact Number *</span>
      <input
        type="tel"
        name="phone"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Your Contact Number"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Equipment Needed *</span>
      <select
        name="equipment"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
      >
        <option value="">Select equipment</option>
        {
          plantFleet.map((item) => (
            <option value={item.title} selected={item.title === selectedEquipment}>
              {item.title}
            </option>
          ))
        }
      </select>
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Rental Start Date</span>
      <input
        type="date"
        name="start_date"
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-neutral-200">Rental Duration *</span>
      <select
        name="duration"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
      >
        <option value="">Select duration</option>
        {durations.map((d) => <option value={d}>{d}</option>)}
      </select>
    </label>

    <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
      <span class="font-medium text-neutral-200">Site Location *</span>
      <input
        type="text"
        name="location"
        required
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Where should the equipment be delivered?"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm md:col-span-2">
      <span class="font-medium text-neutral-200">Message (optional)</span>
      <textarea
        name="message"
        rows={4}
        class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white placeholder:text-neutral-500"
        placeholder="Describe your project requirements..."
      ></textarea>
    </label>

    <p class="text-xs text-neutral-500 md:col-span-2">
      By submitting, you agree we may contact you about this inquiry. We process data in line with POPIA.
    </p>

    <div class="md:col-span-2">
      <button
        type="submit"
        class="w-full rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover md:w-auto"
      >
        Send Hire Inquiry
      </button>
      <p id="form-status" class="mt-3 hidden text-sm" role="status"></p>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById("hire-quote-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;

    const key = form.dataset.accessKey;
    const fallbackEmail = form.dataset.fallbackEmail ?? "";

    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const phone = String(data.get("phone") ?? "");
    const equipment = String(data.get("equipment") ?? "");
    const location = String(data.get("location") ?? "");

    status.classList.remove("hidden", "text-green-300", "text-red-300");
    status.textContent = "Sending…";

    if (!key) {
      const body = [
        `Name: ${name}`,
        `Phone: ${phone}`,
        `Equipment: ${equipment}`,
        `Location: ${location}`,
        `Email: ${data.get("email")}`,
        `Duration: ${data.get("duration")}`,
        `Start: ${data.get("start_date")}`,
        `Message: ${data.get("message")}`,
      ].join("%0D%0A");
      window.location.href = `mailto:${fallbackEmail}?subject=${encodeURIComponent("Plant Hire Inquiry - " + equipment)}&body=${body}`;
      return;
    }

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: data,
      });
      const json = await res.json();
      if (json.success) {
        status.textContent = "Thank you — we'll respond soon.";
        status.classList.add("text-green-300");
        form.reset();
      } else {
        throw new Error(json.message ?? "Submission failed");
      }
    } catch {
      status.textContent = "Something went wrong. Please call or WhatsApp us directly.";
      status.classList.add("text-red-300");
    }
  });
</script>
