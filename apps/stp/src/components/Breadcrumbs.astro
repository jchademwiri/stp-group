---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className = "" } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["text-sm text-neutral-400", className]}>
  <ol class="flex flex-wrap items-center gap-1.5">
    <li>
      <a href="/" class="transition-colors hover:text-safety">Home</a>
    </li>
    {
      crumbs.map((crumb) => (
        <>
          <li aria-hidden="true" class="text-neutral-600">/</li>
          <li>
            {crumb.href
              ? <a href={crumb.href} class="transition-colors hover:text-safety">{crumb.label}</a>
              : <span class="text-neutral-200">{crumb.label}</span>
            }
          </li>
        </>
      ))
    }
  </ol>
</nav>
