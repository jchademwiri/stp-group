---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "sticky top-[64px] md:top-[72px] z-20 border-b border-white/10 bg-charcoal/95 backdrop-blur",
    className,
  ]}
>
  <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 py-3 md:px-6">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-neutral-400">
      <li>
        <a href="/" class="transition-colors hover:text-brand">Home</a>
      </li>
      {
        crumbs.map((crumb) => (
          <>
            <li aria-hidden="true" class="text-neutral-600">/</li>
            <li>
              {crumb.href
                ? <a href={crumb.href} class="transition-colors hover:text-brand">{crumb.label}</a>
                : <span class="text-neutral-200">{crumb.label}</span>
              }
            </li>
          </>
        ))
      }
    </ol>
  </nav>
</div>
