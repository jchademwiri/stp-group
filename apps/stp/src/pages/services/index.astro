---
import StpLayout from '@/layouts/StpLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  SITE,
  whatsappUrl,
  WHATSAPP_DEFAULT_MESSAGE,
  breadcrumbSchema,
} from '@/data/site';

const title = 'Our Services | Sithembe Plant Hire, Grass Cutting & Desludging';
const description =
  'From plant hire and equipment rental to commercial grass cutting and septic desludging - Sithembe delivers reliable site services across Pretoria and Gauteng.';

const offerings = [
  {
    title: 'Plant Hire & Equipment Rental',
    slug: '/plant-hire',
    icon: 'machinery',
    summary:
      'Dropside trucks, vacuum tankers, bobcats, utility tractors, ride-on mowers, and handheld tools - with wet hire operators available on all major plant.',
    highlights: [
      '8-Ton dropside trucks for bulk material delivery',
      '10,000-litre honey sucker vacuum tanker',
      'Water tankers for dust suppression & bulk supply',
      'Bobcat skid steer loader for earthmoving',
      'Utility tractors with 4WD and implements',
      'TETA/SAMA certified operators included',
    ],
  },
  {
    title: 'Commercial Grass Cutting & Plot Clearing',
    slug: '/services/grass-cutting',
    icon: 'mower',
    summary:
      'Industrial-scale grass cutting, highway verge maintenance, firebreak establishment, and overgrown plot reclamation using agricultural tractors and ride-on mowers.',
    highlights: [
      'Corporate park and estate landscaping',
      'Highway verge and roadside vegetation control',
      'Overgrown plot and smallholding reclamation',
      'Firebreak cutting and seasonal maintenance',
      'Garden services & maintenance',
      'Once-off clearing or bi-weekly contracts',
    ],
  },
  {
    title: 'Septic Tank & Toilet Desludging',
    slug: '/services/desludging',
    icon: 'tanker',
    summary:
      'Professional vacuum extraction of septic tanks, pit latrines, grease traps, and industrial liquid waste. Accredited operators with high-capacity equipment.',
    highlights: [
      'Septic tank emptying (scheduled & emergency)',
      'Toilet and pit latrine desludging',
      'Kitchen grease trap cleaning',
      'Industrial liquid waste removal',
      'Emergency blocked drain response',
      'Mobile toilet hire for events & sites',
    ],
  },
];

const iconSvgs: Record<string, string> = {
  machinery:
    'M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z',
  mower:
    'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM7 10l5-3 5 3-5 3-5-3zM12 14l-5 3m5-3l5 3m-5-3v7',
  tanker: 'M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9zM9 22V12h6v10',
};
---

<StpLayout {title} {description}>
  <Fragment slot='head'>
    <script
      type='application/ld+json'
      set:html={JSON.stringify(
        breadcrumbSchema([{ label: 'Services' }], Astro.site),
      )}
    />
  </Fragment>
  <Breadcrumbs crumbs={[{ label: 'Services' }]} />

  <section
    class='border-b border-white/10 bg-gradient-to-b from-slate to-charcoal'
  >
    <div class='mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24'>
      <h1
        class='mt-8 max-w-3xl text-4xl font-bold tracking-tight text-white md:text-5xl'
      >
        What we do
      </h1>
      <p class='mt-4 max-w-2xl text-lg text-neutral-300'>
        Three service lines. One reliable team. CIDB-registered, fully insured,
        and ready to support your next project across {SITE.region}.
      </p>
      <div class='mt-8 flex flex-wrap gap-3'>
        <a
          href='#plant-hire'
          class='rounded-lg bg-safety px-5 py-2.5 font-semibold text-charcoal hover:bg-safety-hover'
        >
          Plant Hire
        </a>
        <a
          href='#grass-cutting'
          class='rounded-lg border border-white/20 px-5 py-2.5 font-semibold text-white hover:bg-white/5'
        >
          Grass Cutting
        </a>
        <a
          href='#desludging'
          class='rounded-lg border border-white/20 px-5 py-2.5 font-semibold text-white hover:bg-white/5'
        >
          Desludging
        </a>
      </div>
    </div>
  </section>

  {
    offerings.map((offering, i) => (
      <section
        id={offering.slug.split('/').pop()}
        class:list={['scroll-mt-32', i % 2 === 0 ? '' : 'bg-slate/40']}
      >
        <div class='mx-auto max-w-6xl px-4 py-16 md:px-6'>
          <div class='grid gap-10 md:grid-cols-5'>
            <div class='md:col-span-2'>
              <span
                class='flex h-14 w-14 items-center justify-center rounded-xl bg-safety/15'
                aria-hidden='true'
              >
                <svg
                  class='h-7 w-7 text-safety'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='1.5'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                >
                  <path d={iconSvgs[offering.icon]} />
                </svg>
              </span>
              <h2 class='mt-4 text-2xl font-bold text-white'>
                {offering.title}
              </h2>
              <p class='mt-3 text-neutral-400'>{offering.summary}</p>
              <div class='mt-6 flex flex-wrap gap-3'>
                <a
                  href={offering.slug}
                  class='rounded-lg bg-safety px-5 py-2.5 font-semibold text-charcoal hover:bg-safety-hover'
                >
                  View full details
                </a>
                <a
                  href={`tel:${SITE.phoneTel}`}
                  class='rounded-lg border border-white/20 px-5 py-2.5 font-semibold text-white hover:bg-white/5'
                >
                  Call {SITE.phone}
                </a>
              </div>
            </div>
            <div class='md:col-span-3'>
              <h3 class='text-sm font-semibold tracking-wider text-neutral-300 uppercase'>
                What&rsquo;s included
              </h3>
              <ul class='mt-4 grid gap-3 sm:grid-cols-2'>
                {offering.highlights.map((h) => (
                  <li class='flex items-start gap-3 rounded-lg border border-white/10 bg-charcoal/60 px-4 py-3'>
                    <svg
                      class='mt-0.5 h-4 w-4 shrink-0 text-safety'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2.5'
                      aria-hidden='true'
                    >
                      <path d='M20 6L9 17l-5-5' />
                    </svg>
                    <span class='text-sm text-neutral-300'>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class='mx-auto max-w-6xl px-4 py-16 md:px-6'>
    <div class='rounded-2xl border border-white/10 bg-slate/80 p-8 md:p-12'>
      <div class='max-w-2xl'>
        <h2 class='text-2xl font-bold text-white'>
          Not sure which service you need?
        </h2>
        <p class='mt-3 text-neutral-400'>
          Tell us about your site and we&rsquo;ll recommend the right equipment
          and crew. We respond {SITE.responseTime}.
        </p>
        <div class='mt-6 flex flex-wrap gap-3'>
          <a
            href={`tel:${SITE.phoneTel}`}
            class='rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover'
          >
            Call {SITE.phone}
          </a>
          <a
            href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
            target='_blank'
            rel='noopener noreferrer'
            class='rounded-lg border border-whatsapp/50 px-6 py-3 font-semibold text-whatsapp hover:bg-whatsapp/10'
          >
            WhatsApp us
          </a>
          <a
            href='/plant-hire'
            class='rounded-lg border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/5'
          >
            Browse equipment fleet
          </a>
        </div>
      </div>
    </div>
  </section>
</StpLayout>
