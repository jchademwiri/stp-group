---
import StpLayout from '@/layouts/StpLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Accordion from '@/components/Accordion.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import ProjectShowcase from '@/components/ProjectShowcase.astro';
import { SITE, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE, breadcrumbSchema } from '@/data/site';
import { getProjectsByCategory } from '@/data/projects';

const title = 'Commercial Grass Cutting & Plot Clearing Services | Sithembe';
const description =
  'Large-scale grass cutting, highway verge mowing, and wild bush clearing services in Pretoria & Gauteng. Industrial-grade tractors and mowers.';

const services = [
  {
    title: 'Commercial & Estate Landscaping',
    text: 'Precision lawn cutting and maintenance for large corporate parks, municipal grounds, residential estates, and open facilities.',
  },
  {
    title: 'Highway & Verge Maintenance',
    text: 'Roadside clearing, firebreak cutting, and industrial vegetation control for highways, infrastructure paths, and agricultural boundaries.',
  },
  {
    title: 'Overgrown Plot Clearing',
    text: 'Heavy-duty land reclamation of wild, overgrown properties, utilizing brush cutters and chainsaws to remove thick shrubs and tree hazards.',
  },
  {
    title: 'Garden Services & Maintenance',
    text: 'Hedge trimming, flower bed maintenance, pruning, and general garden upkeep for residential estates, commercial complexes, and municipal parks.',
  },
];

const grassProjects = getProjectsByCategory('grass-cutting');

const beforeAfterProjects = [
  {
    title: 'Plot clearing - before & after',
    description:
      'A heavily overgrown 2-hectare smallholding in Centurion. The site was reclaimed using a utility tractor, ride-on mower, and handheld brush cutters. All vegetation was cleared, and the property was left tidy and accessible within 4 days.',
  },
  {
    title: 'Highway verge - before & after',
    description:
      'Roadside vegetation overgrowth cleared along a 3 km municipal road. Firebreak strips established on both sides. The project improved visibility and reduced fire risk ahead of the dry season.',
  },
];
---

<StpLayout {title} {description}>
  <Fragment slot='head'>
    <script
      type='application/ld+json'
      set:html={JSON.stringify(
        breadcrumbSchema(
          [
            { label: 'Services', href: '/services' },
            { label: 'Grass Cutting' },
          ],
          Astro.site,
        ),
      )}
    />
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What areas do you cover?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: `We primarily serve ${SITE.region}. Contact us for large contracts or sites outside this area.`,
            },
          },
          {
            '@type': 'Question',
            name: 'How is pricing calculated?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Pricing depends on plot size, terrain, vegetation density, and service frequency. Call or WhatsApp us to discuss your requirements.',
            },
          },
          {
            '@type': 'Question',
            name: 'Do you handle very large plots (10+ hectares)?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Yes - we deploy tractors, ride-on mowers, and clearing crews suited to large-scale reclamation and maintenance contracts.',
            },
          },
          {
            '@type': 'Question',
            name: 'How long does a typical clearing take?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Once-off reclamation varies from one day to several days depending on acreage and overgrowth. We'll estimate timelines when you enquire.",
            },
          },
        ],
      })}
    />
  </Fragment>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services' },
      { label: 'Grass Cutting' },
    ]}
  />

  <section
    class='border-b border-white/10 bg-gradient-to-b from-slate to-charcoal'
  >
    <div class='mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20'>
      <h1 class='mt-8 text-4xl font-bold text-white md:text-5xl'>
        Industrial & Commercial Grass Cutting & Plot Clearing
      </h1>
      <p class='mt-4 max-w-2xl text-lg text-neutral-300'>
        Professional clearing, firebreak establishment, and site maintenance
        using agricultural tractors and ride-on mowers in {SITE.region}.
      </p>

    </div>
  </section>

  <section class='mx-auto max-w-6xl px-4 py-12 md:px-6'>
    <h2 class='text-2xl font-bold text-white'>Services</h2>
    <div class='mt-8 grid gap-6 md:grid-cols-3'>
      {
        services.map((s) => (
          <article class='rounded-xl border border-white/10 bg-slate/80 p-6'>
            <h3 class='font-semibold text-white'>{s.title}</h3>
            <p class='mt-2 text-sm text-neutral-400'>{s.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Before & After Gallery -->
  <section class='border-y border-white/10 bg-slate/40 py-12'>
    <div class='mx-auto max-w-6xl px-4 md:px-6'>
      <h2 class='text-2xl font-bold text-white'>
        Before &amp; after - real results
      </h2>
      <p class='mt-2 text-neutral-400'>
        See the difference our equipment and crews make.
      </p>
      <div class='mt-8 grid gap-8 md:grid-cols-2'>
        {
          beforeAfterProjects.map((p) => (
            <BeforeAfter title={p.title} description={p.description} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Project Showcase -->
  <section class='mx-auto max-w-6xl px-4 py-12 md:px-6'>
    <h2 class='text-2xl font-bold text-white'>Contract awards</h2>
    <p class='mt-2 text-neutral-400'>
      Real municipal contracts we&rsquo;ve been awarded across {SITE.region} and beyond.
    </p>
    <div class='mt-8 grid gap-6 md:grid-cols-2'>
      {
        grassProjects.map((p) => (
          <ProjectShowcase
            title={p.title}
            client={p.client}
            description={p.description}
            stats={p.stats}
          />
        ))
      }
    </div>
  </section>

  <section class='mx-auto max-w-6xl px-4 py-8 md:px-6'>
    <h2 class='text-xl font-semibold text-white'>Equipment deployed</h2>
    <p class='mt-2 text-neutral-400'>
      Utility tractors, ride-on mowers, and brush cutters operated by accredited crews across
      municipal and commercial contracts.
    </p>
  </section>

  <section class='mx-auto max-w-6xl px-4 pb-16 md:px-6'>
    <h2 class='text-lg font-semibold text-white'>Frequently asked questions</h2>
    <div class='mt-4 flex flex-col gap-3'>
      <Accordion question='What areas do you cover?'>
        We primarily serve {SITE.region}. Contact us for large contracts or
        sites outside this area.
      </Accordion>

      <Accordion question='Do you handle very large plots (10+ hectares)?'>
        Yes - we deploy tractors, ride-on mowers, and clearing crews suited to
        large-scale reclamation and maintenance contracts.
      </Accordion>
      <Accordion question='How long does a typical clearing take?'>
        Once-off reclamation varies from one day to several days depending on
        acreage and overgrowth. We'll estimate timelines when you enquire.
      </Accordion>
    </div>
  </section>
</StpLayout>
