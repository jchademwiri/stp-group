---
import StpLayout from "@/layouts/StpLayout.astro";
import TrustBadges from "@/components/TrustBadges.astro";
import { SITE, whatsappUrl } from "@/data/site";

const title = "Commercial Grass Cutting & Plot Clearing Services | Sithembe";
const description =
  "Large-scale grass cutting, highway verge mowing, and wild bush clearing services in Pretoria & Gauteng. Industrial-grade tractors and mowers.";

const services = [
  {
    title: "Commercial & Estate Landscaping",
    text: "Precision lawn cutting and maintenance for large corporate parks, municipal grounds, residential estates, and open facilities.",
  },
  {
    title: "Highway & Verge Maintenance",
    text: "Roadside clearing, firebreak cutting, and industrial vegetation control for highways, infrastructure paths, and agricultural boundaries.",
  },
  {
    title: "Overgrown Plot Clearing",
    text: "Heavy-duty land reclamation of wild, overgrown properties, utilizing brush cutters and chainsaws to remove thick shrubs and tree hazards.",
  },
];

const areaOptions = [
  "Under 1,000 m²",
  "1,000 m² - 5,000 m²",
  "0.5 Hectares - 1 Hectare",
  "1 - 5 Hectares",
  "5 Hectares+",
];

const frequencyOptions = [
  "Once-off Clearing / Reclamation",
  "Bi-weekly Maintenance",
  "Monthly Maintenance Contract",
  "Seasonal Clearing / Firebreak",
];
---

<StpLayout {title} {description}>
  <section class="border-b border-white/10 bg-gradient-to-b from-slate to-charcoal">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <TrustBadges />
      <h1 class="mt-8 text-4xl font-bold text-white md:text-5xl">
        Industrial & Commercial Grass Cutting & Plot Clearing
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">
        Professional clearing, firebreak establishment, and site maintenance using agricultural
        tractors and ride-on mowers in {SITE.region}.
      </p>
      <a
        href="#grass-quote"
        class="mt-8 inline-block rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
      >
        Get Clearing Estimate
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="text-2xl font-bold text-white">Services</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        services.map((s) => (
          <article class="rounded-xl border border-white/10 bg-slate/80 p-6">
            <h3 class="font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-sm text-neutral-400">{s.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    <h2 class="text-xl font-semibold text-white">Equipment deployed</h2>
    <p class="mt-2 text-neutral-400">
      Utility tractors, ride-on mowers, and brush cutters from our{" "}
      <a href="/plant-hire" class="text-safety hover:underline">plant hire fleet</a>.
    </p>
  </section>

  <section id="grass-quote" class="mx-auto max-w-6xl scroll-mt-8 px-4 py-12 pb-20 md:px-6">
    <div class="rounded-2xl border border-white/10 bg-slate p-6 md:p-10">
      <h2 class="text-2xl font-bold text-white">Book a Grass Cutting Consultation</h2>
      <p class="mt-2 text-neutral-400">
        Tell us about your site — we'll respond {SITE.responseTime}. For urgent quotes, use WhatsApp.
      </p>
      <form
        class="mt-6 grid gap-4 md:grid-cols-2"
        action={whatsappUrl(
          "Hi Sithembe, I'd like a grass cutting / plot clearing quote. Please contact me.",
        )}
        method="get"
        target="_blank"
      >
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-medium text-neutral-200">Your Full Name *</span>
          <input
            type="text"
            name="from"
            required
            class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-medium text-neutral-200">Phone *</span>
          <input
            type="tel"
            required
            class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-medium text-neutral-200">Estimated area</span>
          <select class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white">
            {areaOptions.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="font-medium text-neutral-200">Service frequency</span>
          <select class="rounded-lg border border-white/15 bg-charcoal px-4 py-2.5 text-white">
            {frequencyOptions.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <p class="text-xs text-neutral-500 md:col-span-2">
          Full online submission (Web3Forms) ships with plant hire form — use WhatsApp for grass
          quotes in MVP.
        </p>
        <div class="md:col-span-2">
          <button
            type="submit"
            class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
          >
            Request via WhatsApp
          </button>
        </div>
      </form>
    </div>
  </section>
</StpLayout>
