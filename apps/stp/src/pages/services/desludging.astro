---
import StpLayout from "@/layouts/StpLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Accordion from "@/components/Accordion.astro";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import DesludgeQuoteForm from "@/components/DesludgeQuoteForm.astro";
import { SITE, breadcrumbSchema } from "@/data/site";
import { getProjectsByCategory } from "@/data/projects";

const desludgeProjects = getProjectsByCategory("desludging");

const title = "Septic Tank & Toilet Desludging Services | Sithembe";
const description =
  "Professional septic tank emptying, toilet desludging, and liquid waste extraction in Pretoria & Gauteng. Accredited operators, industrial vacuum tankers.";

const services = [
  {
    title: "Septic Tank Emptying",
    text: "Scheduled and emergency septic tank pump-outs for residential estates, commercial properties, and smallholdings using high-capacity vacuum tankers.",
  },
  {
    title: "Toilet & Pit Latrine Desludging",
    text: "Municipal, construction-site, and portable toilet servicing. We handle pit latrines, chemical toilets, and temporary ablution facilities.",
  },
  {
    title: "Grease Trap Cleaning",
    text: "Restaurant and kitchen grease trap maintenance to prevent blockages and comply with municipal health regulations.",
  },
  {
    title: "Industrial Liquid Waste",
    text: "Factory sludge, process water, and industrial wastewater removal with proper disposal and compliance documentation.",
  },
  {
    title: "Emergency Blocked Drains",
    text: "Fast-response high-suction drain unblocking for blocked sewer lines, overflowing tanks, and drainage emergencies.",
  },
  {
    title: "Site & Event Servicing",
    text: "Construction site, market, and event toilet block servicing - regular collection schedules to keep facilities clean and functional.",
  },
  {
    title: "Mobile Toilet Hire",
    text: "Portable toilet rental for construction sites, events, festivals, and temporary setups. Delivery, servicing, and collection included.",
  },
];

const process = [
  { step: "1", title: "Enquire", text: "Submit the form or WhatsApp us with your site details and requirements." },
  { step: "2", title: "Quote & schedule", text: "We assess your needs, provide a quote, and book a convenient time slot." },
  { step: "3", title: "Service & confirm", text: "Our accredited operator arrives on schedule, completes the work, and provides documentation." },
];

const faqs = [
  {
    q: "How often should a septic tank be emptied?",
    a: "Most residential tanks need emptying every 2–3 years, but this depends on tank size, household volume, and usage. Commercial or high-traffic sites may need quarterly or monthly servicing.",
  },
  {
    q: "What areas do you cover?",
    a: `We primarily serve ${SITE.region}. Contact us for large contracts or sites outside this area.`,
  },
  {
    q: "Do you provide compliance documentation?",
    a: "Yes - we provide waste removal certificates and disposal documentation for municipal compliance, CIDB sites, and health inspections.",
  },
  {
    q: "How quickly can you respond to an emergency?",
    a: "We aim to respond within 2 hours during business hours for urgent callouts such as overflowing tanks or blocked drains.",
  },
  {
    q: "What size tanks can you handle?",
    a: "Our 10,000-litre honey sucker vacuum tanker handles everything from small household septic tanks to large industrial waste containers.",
  },
  {
    q: "Do you offer mobile toilet hire?",
    a: "Yes — we provide portable toilet rental for construction sites, events, festivals, and temporary setups. Delivery, regular servicing, and collection are all included.",
  },
  {
    q: "How many portable toilets do I need for my event or site?",
    a: "A general rule is 1 toilet per 50 people for events, and 1 per 15 workers on construction sites per shift. We can advise on the right number when you enquire — and our quote form has a dedicated field for units.",
  },
  {
    q: "How often are hired toilets serviced?",
    a: "Weekly servicing is standard for ongoing hires. We clean, sanitise, and restock each unit on a set schedule. For peak events we can service daily if needed.",
  },
];
---

<StpLayout {title} {description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ label: "Services", href: "/services" }, { label: "Desludging" }], Astro.site))} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How often should a septic tank be emptied?",
          acceptedAnswer: { "@type": "Answer", text: "Most residential tanks need emptying every 2-3 years, but this depends on tank size, household volume, and usage. Commercial or high-traffic sites may need quarterly or monthly servicing." },
        },
        {
          "@type": "Question",
          name: "What areas do you cover?",
          acceptedAnswer: { "@type": "Answer", text: `We primarily serve ${SITE.region}. Contact us for large contracts or sites outside this area.` },
        },
        {
          "@type": "Question",
          name: "Do you provide compliance documentation?",
          acceptedAnswer: { "@type": "Answer", text: "Yes - we provide waste removal certificates and disposal documentation for municipal compliance, CIDB sites, and health inspections." },
        },
        {
          "@type": "Question",
          name: "How quickly can you respond to an emergency?",
          acceptedAnswer: { "@type": "Answer", text: "We aim to respond within 2 hours during business hours for urgent callouts such as overflowing tanks or blocked drains." },
        },
        {
          "@type": "Question",
          name: "What size tanks can you handle?",
          acceptedAnswer: { "@type": "Answer", text: "Our 10,000-litre honey sucker vacuum tanker handles everything from small household septic tanks to large industrial waste containers." },
        },
        {
          "@type": "Question",
          name: "Do you offer mobile toilet hire?",
          acceptedAnswer: { "@type": "Answer", text: "Yes — we provide portable toilet rental for construction sites, events, festivals, and temporary setups. Delivery, regular servicing, and collection are all included." },
        },
        {
          "@type": "Question",
          name: "How many portable toilets do I need for my event or site?",
          acceptedAnswer: { "@type": "Answer", text: "A general rule is 1 toilet per 50 people for events, and 1 per 15 workers on construction sites per shift. We can advise on the right number when you enquire." },
        },
        {
          "@type": "Question",
          name: "How often are hired toilets serviced?",
          acceptedAnswer: { "@type": "Answer", text: "Weekly servicing is standard for ongoing hires. We clean, sanitise, and restock each unit on a set schedule. For peak events we can service daily if needed." },
        },
      ],
    })} />
  </Fragment>
  <Breadcrumbs crumbs={[{ label: "Services", href: "/services" }, { label: "Desludging" }]} />

  <section class="border-b border-white/10 bg-gradient-to-b from-slate to-charcoal">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <h1 class="mt-8 text-4xl font-bold text-white md:text-5xl">
        Septic Tank &amp; Toilet Desludging Services
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">
        Professional vacuum extraction of septic tanks, pit latrines, grease traps, and liquid
        waste across {SITE.region}. Accredited operators with industrial-grade equipment.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4 rounded-xl border border-amber-600/30 bg-amber-500/10 px-5 py-4">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-500/20" aria-hidden="true">
            <svg class="h-5 w-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
              <path d="M12 9v4M12 17h.01" />
            </svg>
          </span>
          <div>
            <p class="text-sm font-semibold text-amber-300">Emergency callout?</p>
            <p class="text-xs text-amber-400/80">We respond within 2 hours during business hours</p>
          </div>
        </div>
        <a
          href={`tel:${SITE.phoneTel}`}
          class="ml-auto flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2.5 font-bold text-charcoal transition-colors hover:bg-amber-400"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
          </svg>
          Call {SITE.phone}
        </a>
      </div>

      <a
        href="#desludge-quote"
        class="mt-6 inline-block rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
      >
        Get a Desludging Quote
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="text-2xl font-bold text-white">What we do</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <article class="rounded-xl border border-white/10 bg-slate/80 p-6">
            <h3 class="font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-sm text-neutral-400">{s.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="text-2xl font-bold text-white">How it works</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        process.map((p) => (
          <div class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-safety text-sm font-bold text-charcoal">
              {p.step}
            </span>
            <div>
              <h3 class="font-semibold text-white">{p.title}</h3>
              <p class="mt-1 text-sm text-neutral-400">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    <h2 class="text-xl font-semibold text-white">Equipment deployed</h2>
    <p class="mt-2 text-neutral-400">
      Our 10,000-litre vacuum tanker (honey sucker) is available from our{" "}
      <a href="/plant-hire/septic-tank-truck" class="text-safety hover:underline">
        plant hire fleet
      </a>{" "}
      - or book our full-service desludging with accredited operators included.
    </p>
  </section>

  <!-- Contract Awards -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="text-2xl font-bold text-white">Contract awards</h2>
    <p class="mt-2 text-neutral-400">Real municipal waste management and hygiene contracts we&rsquo;ve been awarded.</p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {desludgeProjects.map((p) => <ProjectShowcase title={p.title} client={p.client} description={p.description} stats={p.stats} />)}
    </div>
  </section>

  <section id="desludge-quote" class="mx-auto max-w-6xl scroll-mt-32 px-4 py-12 md:px-6">
    <DesludgeQuoteForm />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <h2 class="text-lg font-semibold text-white">Frequently asked questions</h2>
    <div class="mt-4 flex flex-col gap-3">
      {
        faqs.map((f) => (
          <Accordion question={f.q}>
            {f.a}
          </Accordion>
        ))
      }
    </div>
  </section>
</StpLayout>
