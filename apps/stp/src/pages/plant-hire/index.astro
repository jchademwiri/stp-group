---
import StpLayout from "@/layouts/StpLayout.astro";
import TrustBadges from "@/components/TrustBadges.astro";
import FleetCard from "@/components/FleetCard.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import Testimonials from "@/components/Testimonials.astro";
import { FLEET_CATEGORIES, getCategoryCounts, plantFleet } from "@/data/plantFleet";
import { SITE, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE } from "@/data/site";

const title = "Plant Hire & Equipment Rental Pretoria & JHB | Sithembe";
const description =
  "Affordable construction and plant hire services. Rent dropside trucks, honey suckers, bobcats, utility tractors, ride-on mowers, and tools. Qualified operators included.";

const counts = getCategoryCounts();
---

<StpLayout {title} {description}>
  <section class="relative overflow-hidden border-b border-white/10 bg-gradient-to-b from-slate to-charcoal">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <TrustBadges />
      <h1 class="mt-8 max-w-3xl text-4xl font-bold tracking-tight text-white md:text-5xl">
        Heavy Duty Equipment Hire You Can Trust
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">
        Get reliable dropsides, vacuum septic tankers, skid loaders, tractors, and commercial
        clearing tools delivered directly to your site in {SITE.region}.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#fleet"
          class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
        >
          Browse Fleet
        </a>
        <a
          href="#quote-form"
          class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/5"
        >
          Request Custom Quote
        </a>
        <a
          href="/services/grass-cutting"
          class="rounded-lg border border-safety/40 px-6 py-3 font-semibold text-safety hover:bg-safety/10"
        >
          Grass cutting services
        </a>
        <a
          href={`tel:${SITE.phoneTel}`}
          class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-neutral-200 hover:bg-white/5"
        >
          Call {SITE.phone}
        </a>
      </div>
    </div>
  </section>

  <section id="why" class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="text-xl font-semibold text-white">Why hire from Sithembe?</h2>
    <ul class="mt-4 grid gap-4 text-neutral-300 sm:grid-cols-2 lg:grid-cols-4">
      <li class="rounded-lg border border-white/10 bg-slate/50 p-4">
        <strong class="text-white">Wet hire available</strong>
        <p class="mt-1 text-sm">TETA/SAMA certified operators on major plant.</p>
      </li>
      <li class="rounded-lg border border-white/10 bg-slate/50 p-4">
        <strong class="text-white">Fully insured</strong>
        <p class="mt-1 text-sm">Public liability cover for peace of mind.</p>
      </li>
      <li class="rounded-lg border border-white/10 bg-slate/50 p-4">
        <strong class="text-white">CIDB registered</strong>
        <p class="mt-1 text-sm">Grades 6 CE, 6 EP, 6 SH — enterprise-ready.</p>
      </li>
      <li class="rounded-lg border border-white/10 bg-slate/50 p-4">
        <strong class="text-white">Local dispatch</strong>
        <p class="mt-1 text-sm">Fast quotes {SITE.responseTime}.</p>
      </li>
    </ul>
  </section>

  <section id="fleet" class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h2 class="text-2xl font-bold text-white">Our fleet</h2>
    <p class="mt-2 text-neutral-400">Filter by category or view all {plantFleet.length} items.</p>

    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Fleet categories">
      {
        FLEET_CATEGORIES.map((cat, i) => (
          <button
            type="button"
            data-filter={cat.id}
            aria-pressed={i === 0 ? "true" : "false"}
            class:list={[
              "rounded-full px-4 py-2 text-sm font-medium transition",
              i === 0
                ? "bg-safety text-charcoal"
                : "border border-white/15 text-neutral-300 hover:bg-white/5",
            ]}
          >
            {cat.label} ({counts[cat.id]})
          </button>
        ))
      }
    </div>

    <div id="fleet-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {plantFleet.map((item) => <FleetCard item={item} />)}
      <p id="fleet-empty" class="col-span-full hidden py-12 text-center text-neutral-400">
        No equipment in this category.
        <button type="button" data-filter-all class="text-safety underline hover:no-underline">
          View all
        </button>
      </p>
    </div>
  </section>

  <Testimonials />

  <section class="mx-auto max-w-6xl px-4 py-12 pb-20 md:px-6">
    <QuoteForm />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <h2 class="text-lg font-semibold text-white">Frequently asked questions</h2>
    <dl class="mt-4 space-y-4 text-sm text-neutral-300">
      <div>
        <dt class="font-medium text-white">What is wet hire vs dry hire?</dt>
        <dd class="mt-1">
          Wet hire includes a licensed operator and basic insurance. Dry hire is equipment only — operator
          certification applies before handover.
        </dd>
      </div>
      <div>
        <dt class="font-medium text-white">What areas do you serve?</dt>
        <dd class="mt-1">Primary coverage: {SITE.region}. Contact us for deliveries outside this area.</dd>
      </div>
      <div>
        <dt class="font-medium text-white">How do I get rates?</dt>
        <dd class="mt-1">
          Rates vary by equipment and duration. WhatsApp or submit the quote form — we'll respond{" "}
          {SITE.responseTime}.
        </dd>
      </div>
    </dl>
  </section>
</StpLayout>

<script>
  import { initFleetFilter } from "@/scripts/fleet-filter";
  initFleetFilter();
</script>
