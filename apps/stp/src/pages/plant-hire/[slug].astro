---
import StpLayout from "../../layouts/StpLayout.astro";
import FleetImage from "../../components/FleetImage.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import { plantFleet, imageAlt } from "../../data/plantFleet";
import { equipmentWhatsappMessage, whatsappUrl } from "../../data/site";

export function getStaticPaths() {
  return plantFleet.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const waHref = whatsappUrl(equipmentWhatsappMessage(item.title, item.slug));
const hireType = item.rates.operatorCostIncluded ? "Wet hire" : "Dry hire";
const hireExplainer = item.rates.operatorCostIncluded
  ? "Wet Hire rates include a fully licensed, SAMA/TETA accredited operator and basic insurance."
  : "Dry Hire rates exclude operators and fuel; standard operator certification checks apply before handover.";
---

<StpLayout title={item.metaTitle} description={item.metaDescription} whatsappMessage={equipmentWhatsappMessage(item.title, item.slug)}>
  <main class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <nav class="text-sm text-neutral-400">
      <a href="/plant-hire" class="hover:text-safety">Plant Hire</a>
      <span aria-hidden="true"> / </span>
      <span class="text-neutral-200">{item.title}</span>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-2">
      <div>
        <FleetImage src={item.primaryImage} title={item.title} priority />
        {
          item.galleryImages.length > 0 && (
            <div class="mt-4 grid grid-cols-3 gap-2">
              {item.galleryImages.map((src) => (
                <img src={src} alt={imageAlt(item.title)} class="rounded-lg object-cover" />
              ))}
            </div>
          )
        }
      </div>

      <div>
        <span class="rounded-full bg-green-500/20 px-2.5 py-0.5 text-xs font-medium text-green-300">
          Available Now
        </span>
        <h1 class="mt-4 text-3xl font-bold text-white">{item.title}</h1>
        <p class="mt-2 text-lg font-medium text-safety">{item.rates.indicator}</p>
        <p class="mt-1 text-sm text-neutral-400">
          {hireType} · Billed {item.rates.basis}
        </p>
        <p class="mt-6 text-neutral-300">{item.longDescription}</p>
        <p class="mt-4 text-sm text-neutral-400">{hireExplainer}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#quote-form"
            class="rounded-lg bg-safety px-5 py-2.5 font-semibold text-charcoal hover:bg-safety-hover"
          >
            Book Equipment
          </a>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-white/20 px-5 py-2.5 font-semibold text-white hover:bg-white/5"
          >
            Inquire via WhatsApp
          </a>
        </div>
      </div>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-white">Technical specifications</h2>
      <table class="mt-4 w-full max-w-xl overflow-hidden rounded-lg border border-white/10 text-left text-sm">
        <tbody>
          {
            Object.entries(item.specifications).map(([key, value]) => (
              <tr class="border-b border-white/10 last:border-0">
                <th class="bg-slate/80 px-4 py-3 font-medium text-neutral-200">{key}</th>
                <td class="px-4 py-3 text-neutral-300">{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="mt-12">
      <QuoteForm selectedEquipment={item.title} />
    </section>
  </main>
</StpLayout>
