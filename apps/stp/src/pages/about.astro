---
import StpLayout from "@/layouts/StpLayout.astro";
import TrustBadges from "@/components/TrustBadges.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE } from "@/data/site";
import { ABOUT } from "@/data/about";

const title = "About Sithembe Plant Hire | Our Story & Team";
const description =
  "Learn about Sithembe Plant Hire - CIDB-registered, fully insured equipment hire and site services company based in Pretoria, serving Gauteng since inception.";

const iconPaths: Record<string, string> = {
  clock:
    "M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v6l4 2",
  shield:
    "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
  eye:
    "M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zM12 9a3 3 0 100 6 3 3 0 000-6z",
  map:
    "M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 7a3 3 0 100 6 3 3 0 000-6z",
};
---

<StpLayout {title} {description}>
  <Breadcrumbs crumbs={[{ label: "About" }]} />

  <section class="border-b border-white/10 bg-gradient-to-b from-slate to-charcoal">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <TrustBadges />
      <h1 class="mt-8 max-w-3xl text-4xl font-bold tracking-tight text-white md:text-5xl">
        {ABOUT.story.headline}
      </h1>
      <div class="mt-6 max-w-2xl space-y-4 text-lg text-neutral-300">
        {ABOUT.story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <h2 class="text-2xl font-bold text-white">Our values</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        ABOUT.values.map((v) => (
          <div class="flex gap-4 rounded-xl border border-white/10 bg-slate/80 p-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-safety/15">
              <svg
                class="h-5 w-5 text-safety"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={iconPaths[v.icon]} />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-white">{v.title}</h3>
              <p class="mt-1 text-sm text-neutral-400">{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-white/10 bg-slate/40 py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="text-2xl font-bold text-white">Our team</h2>
      <p class="mt-2 max-w-2xl text-neutral-400">
        Behind every delivery and every job site is a team committed to keeping your project running.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          ABOUT.team.map((t) => (
            <article class="rounded-xl border border-white/10 bg-charcoal/60 p-6">
              <p class="text-xs font-medium tracking-wider text-safety uppercase">{t.role}</p>
              <h3 class="mt-2 text-lg font-semibold text-white">{t.name}</h3>
              <p class="mt-2 text-sm text-neutral-400">{t.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <h2 class="text-2xl font-bold text-white">Credentials & compliance</h2>
    <p class="mt-2 max-w-2xl text-neutral-400">
      We meet the regulatory and insurance requirements that government, municipal, and commercial
      clients expect.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        ABOUT.credentials.map((c) => (
          <div class="flex items-start gap-3 rounded-lg border border-white/10 bg-slate/50 p-4">
            <svg
              class="mt-0.5 h-5 w-5 shrink-0 text-safety"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
              <path d="M22 4L12 14.01l-3-3" />
            </svg>
            <div>
              <p class="text-sm font-semibold text-white">{c.label}</p>
              <p class="text-xs text-neutral-500">{c.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <h2 class="text-lg font-semibold text-white">Ready to work with us?</h2>
    <p class="mt-2 text-neutral-400">
      Whether you need a single machine for a day or a full-service contract, we're here to help.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={`tel:${SITE.phoneTel}`}
        class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
      >
        Call {SITE.phone}
      </a>
      <a
        href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-whatsapp/50 px-6 py-3 font-semibold text-whatsapp hover:bg-whatsapp/10"
      >
        WhatsApp us
      </a>
      <a
        href="/plant-hire"
        class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/5"
      >
        Browse fleet
      </a>
    </div>
  </section>
</StpLayout>
