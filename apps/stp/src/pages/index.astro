---
import StpLayout from "@/layouts/StpLayout.astro";
import TrustBadges from "@/components/TrustBadges.astro";
import { SITE, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE, absoluteUrl } from "@/data/site";
import { ABOUT } from "@/data/about";
import { stpContracts } from "@/data/contracts";

const title = "Sithembe | Municipal Contractor — Plant Hire, Grass Cutting & Desludging";
const description = SITE.description;

const iconPaths: Record<string, string> = {
  clock: "M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v6l4 2",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
  eye: "M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zM12 9a3 3 0 100 6 3 3 0 000-6z",
  map: "M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 7a3 3 0 100 6 3 3 0 000-6z",
};

const services = [
  {
    title: "Plant hire & equipment",
    description:
      "Dropside trucks, vacuum tankers, bobcats, tractors, and mowers — with wet hire operators where required for municipal and construction projects.",
  },
  {
    title: "Grass cutting & clearing",
    description:
      "Commercial estates, highway verges, and overgrown plot reclamation using industrial tractors and ride-on mowers.",
  },
  {
    title: "Septic & desludging",
    description:
      "Septic tank emptying, toilet desludging, grease trap cleaning, and liquid waste extraction with accredited operators.",
  },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.tradingName,
  legalName: SITE.legalName,
  url: Astro.site ?? SITE.url,
  logo: absoluteUrl("/logo-white.svg", Astro.site),
  description: SITE.description,
  telephone: SITE.phoneTel,
  email: SITE.email,
  areaServed: SITE.region,
  foundingDate: "2020",
  sameAs: Object.values(SITE.socialLinks ?? {}).filter(Boolean),
};
---

<StpLayout {title} {description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-bg">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 55% at 50% 15%, color-mix(in srgb, var(--color-brand) 12%, transparent) 0%, transparent 70%);"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <div class="mb-5 flex items-center gap-3">
        <span class="h-px w-6 bg-brand/50"></span>
        <span class="font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase">Sithembe Group</span>
      </div>
      <h1 class="font-display text-4xl font-medium tracking-tight text-ink md:text-6xl">
        Municipal contracts.<br /> <em class="text-brand italic">Reliable</em> delivery.
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink/60">
        CIDB-registered across grades 6CE, 6EP, 6SH, 5GB and 4SK — we deliver plant hire,
        vegetation management, and sanitation services for municipalities and industry across
        {SITE.region}. Accredited operators, full insurance, proven track record.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`tel:${SITE.phoneTel}`}
          class="rounded-lg bg-brand px-6 py-3 font-sans text-xs font-medium tracking-wide text-bg uppercase hover:bg-brand-hover"
        >
          Call {SITE.phone}
        </a>
        <a
          href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-whatsapp/50 px-6 py-3 font-sans text-xs font-medium tracking-wide text-whatsapp uppercase hover:bg-whatsapp/10"
        >
          WhatsApp us
        </a>
      </div>
      <div class="mt-10">
        <TrustBadges />
      </div>
    </div>
  </section>

  <!-- Our Services -->
  <section id="services" class="scroll-mt-24 border-y border-ink/10 bg-bg-elevated/40 py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="mb-3 flex items-center gap-3">
        <span class="h-px w-6 bg-brand/50"></span>
        <span class="font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase">What we do</span>
      </div>
      <h2 class="font-display text-3xl font-medium text-ink md:text-4xl">Our services</h2>
      <p class="mt-3 max-w-2xl text-ink/60">
        Three service lines backed by CIDB registration, accredited operators, and a
        proven track record across municipal and private-sector contracts.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {services.map((service) => (
          <article class="rounded-lg border border-ink/10 bg-bg p-8">
            <h3 class="font-display text-xl font-medium text-ink">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink/60">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Track Record -->
  <section id="projects" class="scroll-mt-24 border-b border-ink/10 bg-bg py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="mb-3 flex items-center gap-3">
        <span class="h-px w-6 bg-brand/50"></span>
        <span class="font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase">Contract awards</span>
      </div>
      <h2 class="font-display text-3xl font-medium text-ink md:text-4xl">Our track record</h2>
      <p class="mt-3 max-w-2xl text-ink/60">
        Active contracts with the City of Tshwane Metropolitan Municipality — we're trusted
        with municipal fleet, equipment, and community infrastructure services.
      </p>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {stpContracts.map((contract) => (
          <div class="flex items-start gap-3 rounded-lg border border-ink/10 bg-bg-elevated/40 px-5 py-4">
            <svg
              class="mt-0.5 h-5 w-5 shrink-0 text-brand"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
              <path d="M22 4L12 14.01l-3-3" />
            </svg>
            <div>
              <span class="text-sm text-ink/80">{contract.title}</span>
              <p class="mt-1 font-sans text-xs tracking-wide text-ink/40 uppercase">
                Tender {contract.ref} &middot; {contract.department}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Sithembe -->
  <section id="why" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 md:px-6">
    <div class="mb-3 flex items-center gap-3">
      <span class="h-px w-6 bg-brand/50"></span>
      <span class="font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase">Why choose us</span>
    </div>
    <h2 class="font-display text-3xl font-medium text-ink md:text-4xl">Why Sithembe</h2>
    <p class="mt-3 max-w-2xl text-ink/60">
      Municipal trust, accredited operators, and a commitment to showing up — here&rsquo;s what sets us apart.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        ABOUT.values.map((v) => (
          <div class="flex gap-4 rounded-lg border border-ink/10 bg-bg-elevated/40 p-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand/15">
              <svg
                class="h-6 w-6 text-brand"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={iconPaths[v.icon]} />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-medium text-ink">{v.title}</h3>
              <p class="mt-1 text-sm text-ink/60">{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-24 border-t border-ink/10 bg-bg-elevated/40 py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="mb-3 flex items-center gap-3">
        <span class="h-px w-6 bg-brand/50"></span>
        <span class="font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase">About us</span>
      </div>
      <h2 class="font-display text-3xl font-medium text-ink md:text-4xl">{ABOUT.story.headline}</h2>
      <p class="mt-4 max-w-2xl text-ink/60">{ABOUT.story.blurb}</p>
    </div>
  </section>
</StpLayout>
