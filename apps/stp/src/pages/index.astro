---
import StpLayout from "../layouts/StpLayout.astro";
import TrustBadges from "../components/TrustBadges.astro";
import { SITE, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE } from "../data/site";
---

<StpLayout
  title="Sithembe | Plant Hire & Site Services"
  description="Plant hire, equipment rental and grass cutting services in Pretoria and Gauteng."
>
  <main class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <p class="text-sm font-medium uppercase tracking-wider text-safety">Sithembe Group</p>
    <h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white md:text-5xl">
      Plant hire & clearing services you can trust
    </h1>
    <p class="mt-4 max-w-xl text-lg text-neutral-400">
      Browse our fleet, request a quote, or message dispatch on WhatsApp. Serving {SITE.region}.
    </p>
    <div class="mt-6">
      <TrustBadges />
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/plant-hire"
        class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
      >
        Plant hire fleet
      </a>
      <a
        href="/services/grass-cutting"
        class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/5"
      >
        Grass cutting services
      </a>
      <a
        href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-whatsapp/50 px-6 py-3 font-semibold text-whatsapp hover:bg-whatsapp/10"
      >
        WhatsApp dispatch
      </a>
    </div>
  </main>
</StpLayout>
