---
import StpLayout from "@/layouts/StpLayout.astro";
import TrustBadges from "@/components/TrustBadges.astro";
import Testimonials from "@/components/Testimonials.astro";
import { SITE, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE } from "@/data/site";

const title = "Sithembe | Plant Hire & Site Services";
const description = SITE.description;
---

<StpLayout {title} {description}>
    <section class="bg-gradient-to-b from-slate to-charcoal">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <p class="text-sm font-medium tracking-wider text-safety uppercase">Sithembe Group</p>
        <h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-white md:text-5xl">
          Equipment on site when you need it. Across Pretoria &amp; Gauteng.
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-neutral-300">
          Downtime costs money. That&rsquo;s why we deliver reliable wet and dry hire plant,
          commercial vehicles, and grounds maintenance equipment &mdash; with accredited operators,
          full insurance, and no runaround. CIDB-registered and ready to roll.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`tel:${SITE.phoneTel}`}
            class="rounded-lg bg-safety px-6 py-3 font-semibold text-charcoal hover:bg-safety-hover"
          >
            Call {SITE.phone}
          </a>
          <a
            href="/plant-hire"
            class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/5"
          >
            Browse plant hire
          </a>
          <a
            href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-whatsapp/50 px-6 py-3 font-semibold text-whatsapp hover:bg-whatsapp/10"
          >
            WhatsApp dispatch
          </a>
        </div>
        <div class="mt-8">
          <TrustBadges />
        </div>
      </div>
    </section>

    <Testimonials />

    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
      <h2 class="text-2xl font-bold text-white">Our services</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article class="rounded-xl border border-white/10 bg-slate/80 p-8">
          <h3 class="text-xl font-semibold text-white">Plant hire</h3>
          <p class="mt-3 text-neutral-400">
            Dropside trucks, bobcats, tractors, mowers, and handheld tools - with wet
            hire operators where required.
          </p>
          <a href="/plant-hire" class="mt-6 inline-block font-semibold text-safety hover:underline">
            View fleet →
          </a>
        </article>
        <article class="rounded-xl border border-white/10 bg-slate/80 p-8">
          <h3 class="text-xl font-semibold text-white">Grass cutting & clearing</h3>
          <p class="mt-3 text-neutral-400">
            Commercial estates, highway verges, and overgrown plot reclamation using industrial
            tractors and ride-on mowers.
          </p>
          <a
            href="/services/grass-cutting"
            class="mt-6 inline-block font-semibold text-safety hover:underline"
          >
            Grass cutting services →
          </a>
        </article>
        <article class="rounded-xl border border-white/10 bg-slate/80 p-8">
          <h3 class="text-xl font-semibold text-white">Septic & desludging</h3>
          <p class="mt-3 text-neutral-400">
            Septic tank emptying, toilet desludging, grease trap cleaning, and liquid
            waste extraction with accredited operators.
          </p>
          <a
            href="/services/desludging"
            class="mt-6 inline-block font-semibold text-safety hover:underline"
          >
            Desludging services →
          </a>
        </article>
      </div>
    </section>
</StpLayout>
