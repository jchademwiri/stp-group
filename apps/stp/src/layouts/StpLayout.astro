---
import BaseLayout from "@repo/tailwind/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import LocalBusinessSchema from "@/components/LocalBusinessSchema.astro";
import { SITE, formatBusinessHours } from "@/data/site";

interface Props {
  title: string;
  description?: string;
  whatsappMessage?: string;
  ogImage?: string;
}

const { title, description = "", whatsappMessage, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const hours = formatBusinessHours();

// Determine the correct quote form anchor for the sticky mobile bar
const quoteHref =
  currentPath.startsWith("/services/grass-cutting")
    ? "#grass-quote"
    : currentPath.startsWith("/services/desludging")
      ? "#desludge-quote"
      : currentPath.startsWith("/plant-hire")
        ? "#quote-form"
        : undefined;
---

<BaseLayout {title} {description} {ogImage} canonical={Astro.url.href} bodyClass="bg-charcoal text-neutral-100">
  <LocalBusinessSchema slot="head" />
  <slot name="head" slot="head" />
  <header class="sticky top-0 z-30 border-b border-white/10 bg-charcoal/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
      <a href="/" class="shrink-0">
        <img src="/logo-white.svg" alt="STP - Sithembe Transportation and Projects" class="h-10 w-auto md:h-12" />
      </a>

      {/* Desktop nav */}
      <nav class="hidden items-center gap-1 text-sm font-medium md:flex" aria-label="Main">
        <a
          href="/plant-hire"
          class:list={["rounded-lg px-3 py-2 transition-colors hover:bg-white/5 hover:text-safety",
            currentPath.startsWith("/plant-hire") ? "font-semibold text-safety" : "text-neutral-300",
          ]}
        >Plant Hire</a>
        <a
          href="/services"
          class:list={["rounded-lg px-3 py-2 transition-colors hover:bg-white/5 hover:text-safety",
            currentPath === "/services" || currentPath === "/services/" ? "font-semibold text-safety" : "text-neutral-300",
          ]}
        >Services</a>
        <a
          href="/services/grass-cutting"
          class:list={["rounded-lg px-3 py-2 transition-colors hover:bg-white/5 hover:text-safety",
            currentPath.startsWith("/services/grass-cutting") ? "font-semibold text-safety" : "text-neutral-300",
          ]}
        >Grass Cutting</a>
        <a
          href="/services/desludging"
          class:list={["rounded-lg px-3 py-2 transition-colors hover:bg-white/5 hover:text-safety",
            currentPath.startsWith("/services/desludging") ? "font-semibold text-safety" : "text-neutral-300",
          ]}
        >Desludging</a>
        <a
          href="/about"
          class:list={["rounded-lg px-3 py-2 transition-colors hover:bg-white/5 hover:text-safety",
            currentPath.startsWith("/about") ? "font-semibold text-safety" : "text-neutral-300",
          ]}
        >About</a>
      </nav>

      {/* Desktop CTAs */}
      <div class="hidden items-center gap-2 md:flex">
        <span class="h-5 w-px bg-white/10" aria-hidden="true"></span>
        <a
          href={quoteHref ?? "/services"}
          class="rounded-lg border border-safety px-3 py-1.5 text-sm font-semibold text-safety transition-colors hover:bg-safety hover:text-charcoal"
        >Get a quote</a>
        <a
          href={`tel:${SITE.phoneTel}`}
          class="rounded-lg bg-safety px-3 py-1.5 font-semibold text-charcoal hover:bg-safety-hover"
        >Call now</a>
      </div>

      {/* Mobile hamburger */}
      <button
        type="button"
        id="nav-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-neutral-300 transition-colors hover:bg-white/5 hover:text-white md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path id="nav-icon-open" d="M4 6h16M4 12h16M4 18h16" />
          <path id="nav-icon-close" class="hidden" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="mobile-nav" class="absolute left-0 right-0 top-full z-40 md:hidden">
      <nav class="border-t border-white/10 bg-charcoal px-4 pb-4 pt-2" aria-label="Mobile navigation">
        <a href="/plant-hire" class:list={["block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5",
          currentPath.startsWith("/plant-hire") ? "text-safety" : "text-neutral-300",
        ]}>Plant Hire</a>
        <a href="/services" class:list={["block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5",
          currentPath === "/services" || currentPath === "/services/" ? "text-safety" : "text-neutral-300",
        ]}>Services</a>
        <a href="/services/grass-cutting" class:list={["block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5",
          currentPath.startsWith("/services/grass-cutting") ? "text-safety" : "text-neutral-300",
        ]}>Grass Cutting</a>
        <a href="/services/desludging" class:list={["block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5",
          currentPath.startsWith("/services/desludging") ? "text-safety" : "text-neutral-300",
        ]}>Desludging</a>
        <a href="/about" class:list={["block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5",
          currentPath.startsWith("/about") ? "text-safety" : "text-neutral-300",
        ]}>About</a>
      </nav>
      <div class="border-t border-white/10 bg-charcoal px-4 pb-4 pt-3">
        <a href={quoteHref ?? "/services"} class="block rounded-lg border border-safety px-3 py-2.5 text-center text-sm font-semibold text-safety transition-colors hover:bg-safety hover:text-charcoal">Get a quote</a>
        <a href={`tel:${SITE.phoneTel}`} class="mt-2 block rounded-lg bg-safety px-3 py-2.5 text-center text-sm font-semibold text-charcoal hover:bg-safety-hover">Call {SITE.phone}</a>
      </div>
    </div>
  </header>

  <style>
    #mobile-nav {
      opacity: 0;
      transform: translateY(-100%);
      visibility: hidden;
      transition: opacity 300ms ease-in-out, transform 300ms ease-in-out, visibility 0s 300ms;
      will-change: transform, opacity;
    }
    #mobile-nav.open {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      transition: opacity 300ms ease-in-out, transform 300ms ease-in-out, visibility 0s;
    }
  </style>

  <script>
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-nav");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    function closeMenu() {
      panel?.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }

    toggle?.addEventListener("click", () => {
      const isOpen = panel?.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      iconOpen?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
    });

    // Close menu when any link inside mobile nav is clicked
    panel?.addEventListener("click", (e) => {
      const link = e.target.closest("a");
      if (link && panel.classList.contains("open")) {
        closeMenu();
      }
    });
  </script>

  <main>
    <slot />
  </main>

  <footer class="border-t border-white/10 bg-charcoal py-10 pb-24 md:pb-10">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="text-sm text-neutral-400">
          <p class="font-semibold text-white">{SITE.tradingName ?? SITE.legalName}</p>
          <p class="mt-2">Serving {SITE.region}</p>
          <p class="mt-1">{hours}</p>
          <p class="mt-4 space-y-1">
            <span class="block">
              <a href={`tel:${SITE.phoneTel}`} class="text-safety hover:underline">{SITE.phone}</a>
              <span class="ml-1.5 text-xs text-neutral-500">Mobile &amp; WhatsApp</span>
            </span>
            <span class="block text-sm text-neutral-400">
              Office: <a href={`tel:${SITE.phoneOfficeTel}`} class="text-safety hover:underline">{SITE.phoneOffice}</a>
            </span>
            <span class="block">
              <a href={`mailto:${SITE.email}`} class="text-safety hover:underline">{SITE.email}</a>
            </span>
          </p>
          <p class="mt-4 text-xs text-neutral-500">
            CIDB Grades 6 CE, 6 EP, 6 SH · COIDA registered · Public liability insured
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">Service area</p>
          <p class="mt-1 text-sm text-neutral-400">Pretoria &amp; Gauteng</p>
          <div class="mt-3 overflow-hidden rounded-lg border border-white/10 bg-slate/80">
            <iframe
              src="https://www.openstreetmap.org/export/embed.html?bbox=27.5%2C-26.5%2C29.5%2C-25.0&amp;layer=mapnik&amp;marker=-25.7479%2C28.2293"
              width="100%"
              height="220"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              title="Map of Gauteng showing our service area"
              class="block"
            ></iframe>
          </div>
          <a
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block text-xs text-safety hover:underline"
          >
            Open in Google Maps →
          </a>
        </div>
      </div>
    </div>
  </footer>

  <WhatsAppButton message={whatsappMessage} />
  <StickyMobileBar quoteHref={quoteHref} />
</BaseLayout>
