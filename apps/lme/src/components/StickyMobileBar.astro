---
import { LME } from "@/data/site";
---

<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-ink/10 bg-bg/40 shadow-[0_-8px_30px_rgba(0,0,0,0.35)] backdrop-blur-xl md:hidden" aria-label="Quick contact">
  <a href={`tel:${LME.phoneTel}`} class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-medium text-ink/70 hover:bg-ink/5">
    <span aria-hidden="true">📞</span>
    Call
  </a>
  <a href={`mailto:${LME.email}`} class="flex flex-col items-center justify-center gap-1 bg-brand/15 py-3 text-xs font-medium text-ink/80 hover:bg-brand/25">
    <span aria-hidden="true">📧</span>
    Email
  </a>
  <a href="#contact" class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-medium text-brand hover:bg-ink/5">
    <span aria-hidden="true">📍</span>
    Contact
  </a>
</nav>
