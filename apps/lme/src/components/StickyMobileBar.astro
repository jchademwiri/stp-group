---
import { LME, WHATSAPP_DEFAULT_MESSAGE, whatsappUrl } from "@/data/site";
---

<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-ink/10 bg-bg/95 backdrop-blur md:hidden" aria-label="Quick contact">
  <a href={`tel:${LME.phoneTel}`} class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-medium text-ink/70 hover:bg-ink/5">
    <span aria-hidden="true">📞</span>
    Call
  </a>
  <a href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1 bg-whatsapp/15 py-3 text-xs font-medium text-ink/80 hover:bg-whatsapp/25">
    <span aria-hidden="true">💬</span>
    WhatsApp
  </a>
  <a href="#contact" class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-medium text-brand hover:bg-ink/5">
    <span aria-hidden="true">📧</span>
    Contact
  </a>
</nav>
