---
import { LME, WHATSAPP_DEFAULT_MESSAGE, whatsappUrl } from "@/data/site";
---

<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-white/10 bg-[#1e1e24]/95 backdrop-blur md:hidden" aria-label="Quick contact">
  <a href={`tel:${LME.phoneTel}`} class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-medium text-neutral-300 hover:bg-white/5">
    <span aria-hidden="true">📞</span>
    Call
  </a>
  <a href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1 bg-[#25d366]/15 py-3 text-xs font-medium text-neutral-200 hover:bg-[#25d366]/25">
    <span aria-hidden="true">💬</span>
    WhatsApp
  </a>
  <a href="#contact" class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-medium text-[#0898c8] hover:bg-white/5">
    <span aria-hidden="true">📧</span>
    Contact
  </a>
</nav>
