---
import { LME } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a
  href={`tel:${LME.phoneTel}`}
  aria-label="Call Livhu and Musa Enterprise"
  class:list={[
    "group fixed right-4 bottom-6 z-50 hidden h-14 w-14 items-center justify-center rounded-full bg-brand text-ink shadow-lg transition hover:scale-105 hover:shadow-xl md:flex",
    className,
  ]}
>
  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
  </svg>
  <span class="pointer-events-none absolute right-full mr-3 hidden rounded-lg bg-bg-elevated px-3 py-2 text-sm whitespace-nowrap text-ink shadow-lg group-hover:block">
    Call us
  </span>
</a>
