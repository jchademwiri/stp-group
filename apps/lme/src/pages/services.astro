---
import LmeLayout from "@/layouts/LmeLayout.astro";
import { LME, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE } from "@/data/site";
import { lmeServiceDetails } from "@/data/services";

const title = "Construction & Civil Engineering Services | LME";
const description =
  "CIDB-registered contractor (1CE, 1GB, 1EP) — civil engineering, general building, and electrical services for municipal and private-sector clients in Gauteng.";
---


<LmeLayout {title} {description}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/10 bg-linear-to-br from-slate to-charcoal">
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.04]"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern id="services-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#services-grid)" />
    </svg>

    <div class="relative mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <p class="mb-3 text-sm font-semibold tracking-wider uppercase text-brand">
        What we deliver
      </p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-white md:text-5xl">
        Our Services
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-400">
        From municipal infrastructure to residential construction — each service
        line is backed by the right CIDB grading, equipment, and experienced teams.
      </p>
    </div>
  </section>

  <!-- Service Blocks -->
  {
    lmeServiceDetails.map((svc, i) => (
      <section
        class:list={[
          "mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20",
          i < lmeServiceDetails.length - 1 ? "border-b border-white/10" : "",
        ]}
      >
        <div class="grid gap-10 md:grid-cols-5">
          <!-- Sidebar: grade badge + title -->
          <div class="md:col-span-2">
            <span class="inline-block rounded-full border border-brand/30 bg-brand/10 px-3 py-1 text-xs font-semibold tracking-wider uppercase text-brand">
              CIDB {svc.code}
            </span>
            <h2 class="mt-4 text-2xl font-bold text-white">{svc.title}</h2>
            <p class="mt-3 leading-relaxed text-neutral-400">
              {svc.expandedDescription}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={`tel:${LME.phoneTel}`}
                class="rounded-lg bg-accent px-5 py-2.5 font-semibold text-charcoal transition-colors hover:bg-accent-hover"
              >
                Inquire about this service
              </a>
              <a
                href="#contact"
                class="rounded-lg border border-white/20 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-white/5"
              >
                Contact us
              </a>
            </div>
          </div>

          <!-- Project types -->
          <div class="md:col-span-3">
            <h3 class="text-sm font-semibold tracking-wider text-neutral-300 uppercase">
              Representative project types
            </h3>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {svc.projectTypes.map((pt) => (
                <li class="flex items-start gap-3 rounded-lg border border-white/10 bg-charcoal/60 px-4 py-3">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-brand"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  <span class="text-sm text-neutral-300">{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  <!-- Bottom CTA -->
  <section id="contact" class="border-t border-white/10 bg-slate/40">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
      <div class="rounded-2xl border border-white/10 bg-slate/80 p-8 md:p-12">
        <h2 class="text-2xl font-bold text-white">Ready to start a project?</h2>
        <p class="mt-3 max-w-2xl text-neutral-400">
          Call, WhatsApp, or email our team. We respond {LME.responseTime}.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`tel:${LME.phoneTel}`}
            class="rounded-lg bg-accent px-6 py-3 font-semibold text-charcoal transition-colors hover:bg-accent-hover"
          >
            Call {LME.phone}
          </a>
          <a
            href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-whatsapp/50 px-6 py-3 font-semibold text-whatsapp transition-colors hover:bg-whatsapp/10"
          >
            WhatsApp us
          </a>
          <a
            href={`mailto:${LME.email}`}
            class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/5"
          >
            Email us
          </a>
        </div>
      </div>
    </div>
  </section>
</LmeLayout>
