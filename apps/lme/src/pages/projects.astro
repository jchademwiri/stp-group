---
import LmeLayout from "@/layouts/LmeLayout.astro";
import { LME, contractCategories, whatsappUrl, WHATSAPP_DEFAULT_MESSAGE } from "@/data/site";

const title = "Projects & Contract Awards | LME";
const description =
  "Track record of municipal and private-sector contracts awarded to Livhu and Musa Enterprise (CIDB 1CE, 1GB, 1EP) — City of Tshwane preferred supplier.";

// Categorise contracts, capturing any unmatched items under "Other"
const categorized: Record<string, string[]> = { ...contractCategories, Other: [] };

for (const contract of LME.contracts) {
  const found = Object.entries(contractCategories).find(([, items]) =>
    items.includes(contract)
  );
  if (!found) {
    categorized["Other"].push(contract);
  }
}

// Filter out empty categories before rendering
const renderedCategories = Object.entries(categorized).filter(
  ([, items]) => items.length > 0
);
---


<LmeLayout {title} {description}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/10 bg-linear-to-br from-slate to-charcoal">
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.04]"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern id="projects-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#projects-grid)" />
    </svg>

    <div class="relative mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <p class="mb-3 text-sm font-semibold tracking-wider uppercase text-brand">
        Our track record
      </p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-white md:text-5xl">
        Projects &amp; Contract Awards
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-400">
        Active and past contracts awarded to Livhu and Musa Enterprise by the
        City of Tshwane Metropolitan Municipality and other clients.
      </p>
    </div>
  </section>

  <!-- Credibility Statement -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="rounded-xl border border-white/10 bg-slate/80 p-6 md:p-8">
      <div class="flex flex-wrap items-center gap-4">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand/15" aria-hidden="true">
          <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </span>
        <div class="flex-1">
          <p class="text-sm text-neutral-300">
            <strong class="text-white">CIDB Registered</strong> — Graded{" "}
            {LME.cidb.grades.map((g) => g.code).join(", ")} &bull;{" "}
            <strong class="text-white">SARS Compliant</strong> &bull;{" "}
            <strong class="text-white">Service Area:</strong> {LME.serviceArea}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contract Categories -->
  {
    renderedCategories.map(([categoryName, contracts]) => (
      <section class="mx-auto max-w-6xl px-4 py-8 md:px-6">
        <h2 class="text-2xl font-bold text-white">{categoryName}</h2>
        <p class="mt-2 text-neutral-400">
          Contracts with City of Tshwane Metropolitan Municipality
        </p>
        <div class="mt-6 grid gap-3">
          {contracts.map((contract) => (
            <div class="flex items-start gap-3 rounded-lg border border-white/10 bg-charcoal/60 px-5 py-4">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-brand"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                <path d="M22 4L12 14.01l-3-3" />
              </svg>
              <span class="text-sm text-neutral-300">{contract}</span>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="rounded-2xl border border-white/10 bg-slate/80 p-8 md:p-12">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-white">
          Looking for a trusted contractor?
        </h2>
        <p class="mt-3 text-neutral-400">
          If you're evaluating tenders or need a CIDB-registered partner for your
          next infrastructure, building, or electrical project — we'd welcome the
          opportunity to quote.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`tel:${LME.phoneTel}`}
            class="rounded-lg bg-accent px-6 py-3 font-semibold text-charcoal transition-colors hover:bg-accent-hover"
          >
            Call {LME.phone}
          </a>
          <a
            href={whatsappUrl(WHATSAPP_DEFAULT_MESSAGE)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-whatsapp/50 px-6 py-3 font-semibold text-whatsapp transition-colors hover:bg-whatsapp/10"
          >
            WhatsApp us
          </a>
          <a
            href={`mailto:${LME.email}`}
            class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/5"
          >
            Email us
          </a>
        </div>
      </div>
    </div>
  </section>
</LmeLayout>
