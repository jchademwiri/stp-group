---
import BaseLayout from "@repo/tailwind/layouts/BaseLayout.astro";

const title = "LME";
---

<BaseLayout title={title}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-brand-900">{title}</h1>
    <p class="mt-4 text-lg text-neutral-600">
      Edit <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-sm">apps/lme/src/pages/index.astro</code> to get started.
    </p>
  </main>
</BaseLayout>
