---
import LmeLayout from '@/layouts/LmeLayout.astro';
import LmeTrustBadges from '@/components/LmeTrustBadges.astro';
import { LME } from '@/data/site';

const title =
  'Livhu and Musa Enterprise | Construction & Civil Engineering - Centurion, Gauteng';
const description = LME.description;

const icons = {
  roads:
    'M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm12 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3z',
  building:
    'M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v.01M12 14v.01M16 14v.01M8 18v.01M12 18v.01M16 18v.01',
  bolt: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  clock:
    'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v6l4 2',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  heart:
    'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
  phone:
    'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z',
  mail: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6',
};
---

<LmeLayout {title} {description}>
  <!-- Hero Section -->
  <section class='relative overflow-hidden bg-bg'>
    <div class='relative mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-[1.3fr_1fr] md:px-6 md:py-28'>
      <div>
        <div class='mb-5 flex items-center gap-3'>
          <span class='h-2 w-2 bg-accent'></span>
          <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>Construction &amp; Civil Engineering</span>
        </div>

        <h1 class='max-w-xl font-display text-5xl leading-[0.95] font-black tracking-tight text-ink uppercase md:text-7xl'>
          Built <span class='text-brand'>right</span>.<br /> Built to <span class='text-accent'>last</span>.
        </h1>

        <p class='mt-6 max-w-xl text-lg text-ink/55'>
          CIDB-registered contractor graded <strong class='font-semibold text-ink'>CE</strong>,
          <strong class='font-semibold text-ink'>GB</strong>, and
          <strong class='font-semibold text-ink'>EP</strong> — serving {LME.serviceArea} with
          proven expertise in civil engineering, general building, and electrical works since {LME.foundingYear}.
        </p>

        <div class='mt-8 flex flex-wrap gap-3'>
          <a
            href={`tel:${LME.phoneTel}`}
            class='rounded-none bg-brand px-6 py-3 font-sans text-xs font-medium tracking-wide text-ink uppercase transition-colors hover:bg-brand-hover'
          >
            Call now
          </a>
          <a
            href='#services'
            class='rounded-none border border-ink/20 px-6 py-3 font-sans text-xs font-medium tracking-wide text-ink uppercase transition-colors hover:bg-ink/5'
          >
            View our services
          </a>
          <a
            href={`mailto:${LME.email}`}
            class='rounded-none border border-brand/50 px-6 py-3 font-sans text-xs font-medium tracking-wide text-brand uppercase transition-colors hover:bg-brand/10'
          >
            Email us
          </a>
        </div>

        <div class='mt-10'>
          <LmeTrustBadges />
        </div>
      </div>

      <div class='relative hidden self-start border border-ink/15 bg-bg-elevated md:block'>
        <div
          class='pointer-events-none absolute inset-0 opacity-40'
          style='background-image: linear-gradient(color-mix(in srgb, var(--color-brand) 60%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-brand) 60%, transparent) 1px, transparent 1px); background-size: 20px 20px;'
        >
        </div>
        <div class='relative divide-y divide-ink/10'>
          <div class='flex items-center justify-between px-6 py-5'>
            <span class='font-sans text-[0.65rem] tracking-[0.2em] text-ink/50 uppercase'>Since</span>
            <span class='font-display text-2xl font-bold text-ink'>{LME.foundingYear}</span>
          </div>
          <div class='flex items-center justify-between px-6 py-5'>
            <span class='font-sans text-[0.65rem] tracking-[0.2em] text-ink/50 uppercase'>Team</span>
            <span class='font-display text-2xl font-bold text-ink'>{LME.employees} <span class='text-sm font-normal text-ink/50'>staff</span></span>
          </div>
          <div class='flex items-center justify-between px-6 py-5'>
            <span class='font-sans text-[0.65rem] tracking-[0.2em] text-ink/50 uppercase'>Fleet</span>
            <span class='font-display text-2xl font-bold text-ink'>{LME.fleet.length} <span class='text-sm font-normal text-ink/50'>items</span></span>
          </div>
          <div class='flex items-center justify-between px-6 py-5'>
            <span class='font-sans text-[0.65rem] tracking-[0.2em] text-ink/50 uppercase'>CIDB</span>
            <span class='font-display text-2xl font-bold text-accent'>{LME.cidb.grades.map((g) => g.code).join(" / ")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section
    id='services'
    class='mx-auto max-w-6xl scroll-mt-28 px-4 pt-24 pb-20 md:px-6'
  >
    <div class='mb-3 flex items-center gap-3'>
      <span class='h-2 w-2 bg-accent'></span>
      <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>What we do</span>
    </div>
    <h2 class='font-display text-3xl font-semibold text-ink md:text-4xl'>Our Services</h2>
    <p class='mt-3 max-w-2xl text-ink/55'>
      From infrastructure to electrical installations - we deliver quality
      construction services across {LME.region}.
    </p>
    <div class='mt-10 grid gap-6 md:grid-cols-3'>
      {
        LME.services.map((s, i) => (
          <article class='border-l-4 border-brand/60 bg-bg-elevated p-8'>
            <div class='flex items-center gap-3'>
              <span class='font-display text-3xl font-bold text-accent'>{String(i + 1).padStart(2, "0")}</span>
              <svg
                class='h-6 w-6 text-brand'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path
                  d={icons[s.icon as keyof typeof icons] || icons.building}
                />
              </svg>
            </div>
            <h3 class='mt-5 font-display text-xl font-semibold text-ink'>{s.title}</h3>
            <p class='mt-3 text-sm leading-relaxed text-ink/55'>
              {s.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Equipment Fleet Section -->
  <section id='fleet' class='border-y-2 border-accent/40 bg-bg-elevated/60' style='clip-path: polygon(0 12px, 100% 0, 100% 100%, 0 100%);'>
    <div    class='mx-auto max-w-6xl scroll-mt-28 px-4 pt-24 pb-20 md:px-6'>
      <div class='mb-3 flex items-center gap-3'>
        <span class='h-2 w-2 bg-accent'></span>
        <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>Our capability</span>
      </div>
      <h2 class='font-display text-3xl font-semibold text-ink md:text-4xl'>Fleet &amp; Equipment</h2>
      <p class='mt-3 max-w-2xl text-ink/55'>
        Over {LME.fleet.length} equipment items - from heavy machinery to handheld
        tools - ready for deployment.
      </p>
      <div class='mt-10 grid grid-cols-1 gap-px border-y border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'>
        {
          LME.fleet.map((item, i) => (
            <div class='flex items-center gap-3 bg-bg-elevated px-4 py-3 text-sm text-ink/70'>
              <span class='shrink-0 font-sans text-xs text-accent'>{String(i + 1).padStart(2, "0")}</span>
              <span>{item}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why LME Section -->
  <section class='mx-auto max-w-6xl px-4 pt-24 pb-20 md:px-6'>
    <div class='mb-3 flex items-center gap-3'>
      <span class='h-2 w-2 bg-accent'></span>
      <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>Why choose us</span>
    </div>
    <h2 class='font-display text-3xl font-semibold text-ink md:text-4xl'>
      Why Livhu and Musa Enterprise?
    </h2>
    <p class='mt-3 max-w-2xl text-ink/55'>
      A decade of experience and a commitment to quality, for public and
      private-sector clients alike — here's what sets us apart.
    </p>
    <div class='mt-10 grid gap-6 sm:grid-cols-2'>
      {
        LME.values.map((v) => (
          <div class='flex gap-4 border-l-4 border-accent/60 bg-bg-elevated p-6'>
            <svg
              class='mt-1 h-6 w-6 shrink-0 text-brand'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path
                d={icons[v.icon as keyof typeof icons] || icons.building}
              />
            </svg>
            <div>
              <h3 class='font-display text-lg font-semibold text-ink'>{v.title}</h3>
              <p class='mt-1 text-sm text-ink/55'>{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Active Projects / Credibility Section -->
  <section id='projects' class='border-y-2 border-accent/40 bg-bg-elevated/60' style='clip-path: polygon(0 12px, 100% 0, 100% 100%, 0 100%);'>
    <div    class='mx-auto max-w-6xl scroll-mt-28 px-4 pt-24 pb-20 md:px-6'>
      <div class='mb-3 flex items-center gap-3'>
        <span class='h-2 w-2 bg-accent'></span>
        <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>Contract awards</span>
      </div>
      <h2 class='font-display text-3xl font-semibold text-ink md:text-4xl'>
        Current &amp; Past Projects
      </h2>
      <p class='mt-3 max-w-2xl text-ink/55'>
        A selection of active contract awards — our team is trusted with critical
        public and private-sector infrastructure.
      </p>
      <div class='mt-10 grid gap-4 md:grid-cols-2'>
        {
          LME.contracts.map((contract) => (
            <div class='flex items-start gap-3 border-l-4 border-brand/60 bg-bg px-5 py-4'>
              <svg
                class='mt-0.5 h-5 w-5 shrink-0 text-brand'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path d='M22 11.08V12a10 10 0 11-5.93-9.14' />
                <path d='M22 4L12 14.01l-3-3' />
              </svg>
              <div>
                <span class='text-sm text-ink/80'>{contract.title}</span>
                {contract.ref && (
                  <p class='mt-1 font-sans text-xs tracking-wide text-ink/40 uppercase'>
                    Tender {contract.ref} &middot; {contract.department}
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id='about' class='scroll-mt-28 border-t border-ink/10 bg-bg-elevated/60 py-16'>
    <div class='mx-auto max-w-6xl px-4 md:px-6'>
      <div class='mb-3 flex items-center gap-3'>
        <span class='h-2 w-2 bg-accent'></span>
        <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>About us</span>
      </div>
      <h2 class='font-display text-3xl font-semibold text-ink md:text-4xl'>About Livhu and Musa Enterprise</h2>
      <p class='mt-4 max-w-2xl text-ink/55'>
        Founded in {LME.foundingYear} in Centurion, Gauteng, LME has grown from
        grass-roots contracts into a
        {LME.employees}-employee, CIDB-registered contractor serving public and
        private-sector clients — SARS compliant, and built on excellence, partnership,
        sustainability, and integrity.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section
    id='contact'
    class='mx-auto max-w-6xl scroll-mt-28 px-4 pt-24 pb-20 md:px-6'
  >
    <div class='mb-3 flex items-center gap-3'>
      <span class='h-2 w-2 bg-accent'></span>
      <span class='font-sans text-[0.65rem] font-medium tracking-[0.3em] text-brand uppercase'>Get in touch</span>
    </div>
    <h2 class='font-display text-3xl font-semibold text-ink md:text-4xl'>Contact Us</h2>
    <p class='mt-3 max-w-2xl text-ink/55'>
      Call or email us for tenders, equipment hire, or project inquiries.
    </p>
    <div class='mt-10 grid gap-8 md:grid-cols-3'>
      <a
        href={`tel:${LME.phoneTel}`}
        class='group flex items-start gap-4 border-l-4 border-ink/10 bg-bg-elevated p-6 transition-colors hover:border-brand'
      >
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-none bg-brand/15 transition-colors group-hover:bg-brand/25'
        >
          <svg
            class='h-6 w-6 text-brand'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d={icons.phone}></path>
          </svg>
        </span>
        <div>
          <h3 class='font-semibold text-ink group-hover:text-brand'>Call us</h3>
          <p class='mt-1 text-sm text-ink/55'>{LME.phone}</p>
          <p class='text-xs text-ink/35'>{LME.businessHours.weekdays}</p>
        </div>
      </a>
      <a
        href={`mailto:${LME.email}`}
        class='group flex items-start gap-4 border-l-4 border-ink/10 bg-bg-elevated p-6 transition-colors hover:border-brand'
      >
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-none bg-brand/15 transition-colors group-hover:bg-brand/25'
        >
          <svg
            class='h-6 w-6 text-brand'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d={icons.mail}></path>
          </svg>
        </span>
        <div>
          <h3 class='font-semibold text-ink group-hover:text-brand'>
            Email us
          </h3>
          <p class='mt-1 text-sm text-ink/55'>{LME.email}</p>
        </div>
      </a>
      <div
        class='flex items-start gap-4 border-l-4 border-accent/60 bg-bg-elevated p-6'
      >
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-none bg-brand/15'
        >
          <svg
            class='h-6 w-6 text-brand'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z'></path>
            <circle cx='12' cy='10' r='3'></circle>
          </svg>
        </span>
        <div>
          <h3 class='font-semibold text-ink'>Visit us</h3>
          <p class='mt-1 text-sm leading-relaxed text-ink/55'>
            {LME.address.street}<br />{LME.address.suburb}<br />{
              LME.address.city
            }, {LME.address.province}
          </p>
        </div>
      </div>
    </div>
  </section>
</LmeLayout>
