---
import LmeLayout from '@/layouts/LmeLayout.astro';
import { LME } from '@/data/site';

const title = 'About Us | LME';
const description =
  'Learn about Livhu and Musa Enterprise — a CIDB-registered construction and civil engineering contractor founded in 2014 in Centurion, Gauteng. Grades 1CE, 1GB, 1EP.';

const icons: Record<string, string> = {
  clock:
    'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v6l4 2',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  building:
    'M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v.01M12 14v.01M16 14v.01M8 18v.01M12 18v.01M16 18v.01',
  heart:
    'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
};

const cidbGradeDetails = [
  {
    code: '1CE',
    name: 'Civil Engineering',
    description:
      'Permits civil engineering work including roads, earthworks, stormwater drainage, and infrastructure maintenance up to the grade 1 contract value threshold.',
  },
  {
    code: '1GB',
    name: 'General Building',
    description:
      'Authorises residential and commercial construction projects — new builds, renovations, alterations, and structural maintenance within grade 1 limits.',
  },
  {
    code: '1EP',
    name: 'Electrical Engineering',
    description:
      'Covers electrical installations, cabling, conduit, and infrastructure for municipal and private-sector projects within grade 1 scope.',
  },
];
---

<LmeLayout {title} {description}>
  <!-- Hero / Intro Section -->
  <section class='relative overflow-hidden bg-linear-to-br from-slate to-charcoal'>
    <div
      class='absolute inset-0 opacity-[0.06]'
      aria-hidden='true'
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"
    ></div>
    <div class='relative mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28'>
      <p class='text-sm font-semibold tracking-wider uppercase text-brand mb-3'>
        About us
      </p>
      <h1 class='max-w-3xl text-4xl font-bold tracking-tight text-white md:text-5xl'>
        About Livhu and Musa Enterprise
      </h1>
      <p class='mt-6 max-w-2xl text-lg leading-relaxed text-neutral-300'>
        Founded in 2014 by <strong class='text-white'>Johannes Mduduzi Mahlangu</strong>,
        Livhu and Musa Enterprise was established in Centurion, Gauteng with a clear purpose:
        to deliver reliable, quality-focused construction and civil engineering services to
        municipal and private-sector clients across the region. Starting with municipal
        contracts awarded by the City of Tshwane Metropolitan Municipality, the company has
        grown steadily — securing CIDB registration across three grades and building a
        workforce of over 10 skilled employees. Every project we take on reflects our
        founding values of excellence, integrity, and sustainable delivery.
      </p>
    </div>
  </section>

  <!-- Company Stats Row -->
  <section class='border-y border-white/10 bg-slate/50'>
    <div class='mx-auto max-w-6xl px-4 py-12 md:px-6'>
      <div class='grid grid-cols-2 gap-4 md:grid-cols-4'>
        <div class='rounded-xl border border-white/10 bg-charcoal p-6 text-center'>
          <p class='text-3xl font-bold text-brand'>{LME.foundingYear}</p>
          <p class='mt-1 text-sm text-neutral-400'>Founded</p>
        </div>
        <div class='rounded-xl border border-white/10 bg-charcoal p-6 text-center'>
          <p class='text-3xl font-bold text-brand'>{LME.employees}</p>
          <p class='mt-1 text-sm text-neutral-400'>Employees</p>
        </div>
        <div class='rounded-xl border border-white/10 bg-charcoal p-6 text-center'>
          <p class='text-xl font-bold text-brand leading-tight'>{LME.address.city}</p>
          <p class='mt-1 text-sm text-neutral-400'>{LME.address.province}</p>
        </div>
        <div class='rounded-xl border border-white/10 bg-charcoal p-6 text-center'>
          <p class='text-xl font-bold text-brand leading-tight'>CIDB</p>
          <p class='mt-1 text-sm text-neutral-400'>Registered</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values Section -->
  <section class='mx-auto max-w-6xl px-4 pt-24 pb-20 md:px-6'>
    <p class='text-sm font-semibold tracking-wider uppercase text-brand mb-3'>
      What drives us
    </p>
    <h2 class='text-3xl font-bold text-white'>Our Values</h2>
    <p class='mt-3 max-w-2xl text-neutral-400'>
      These principles guide every decision we make and every project we deliver —
      from the first site visit to final handover.
    </p>
    <div class='mt-10 grid gap-6 md:grid-cols-2'>
      {
        LME.values.map((v) => (
          <div class='flex gap-4 rounded-xl border border-white/10 bg-slate p-6'>
            <span class='flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand/15'>
              <svg
                class='h-6 w-6 text-brand'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d={icons[v.icon] ?? icons.building} />
              </svg>
            </span>
            <div>
              <h3 class='font-semibold text-white'>{v.title}</h3>
              <p class='mt-1 text-sm leading-relaxed text-neutral-400'>{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Credentials & CIDB Grades Section -->
  <section class='border-y border-white/10 bg-slate/50'>
    <div class='mx-auto max-w-6xl px-4 pt-24 pb-20 md:px-6'>
      <p class='text-sm font-semibold tracking-wider uppercase text-brand mb-3'>
        Our credentials
      </p>
      <h2 class='text-3xl font-bold text-white'>CIDB Grades &amp; Qualifications</h2>
      <p class='mt-3 max-w-2xl text-neutral-400'>
        LME holds active CIDB registration across three engineering disciplines,
        qualifying us for public and private sector tender submissions.
      </p>
      <div class='mt-10 grid gap-6 md:grid-cols-3'>
        {
          cidbGradeDetails.map((grade) => (
            <div class='rounded-xl border border-white/10 bg-charcoal p-6 transition-all duration-200 hover:-translate-y-1 hover:border-brand/30 hover:shadow-lg hover:shadow-black/30'>
              <span class='inline-flex items-center justify-center rounded-lg bg-brand/15 px-3 py-1.5'>
                <span class='text-lg font-bold text-brand'>{grade.code}</span>
              </span>
              <h3 class='mt-4 text-lg font-semibold text-white'>{grade.name}</h3>
              <p class='mt-2 text-sm leading-relaxed text-neutral-400'>
                {grade.description}
              </p>
            </div>
          ))
        }
      </div>
      <div class='mt-8 flex flex-wrap items-center gap-3'>
        <span class='flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-medium text-white'>
          <svg class='h-3.5 w-3.5 shrink-0 text-brand' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' aria-hidden='true'>
            <path d='M9 12l2 2 4-4' />
          </svg>
          SARS Tax Compliant
        </span>
        <span class='flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-medium text-white'>
          <svg class='h-3.5 w-3.5 shrink-0 text-brand' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' aria-hidden='true'>
            <path d='M9 12l2 2 4-4' />
          </svg>
          City of Tshwane Preferred Supplier
        </span>
        <span class='flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-medium text-white'>
          <svg class='h-3.5 w-3.5 shrink-0 text-brand' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' aria-hidden='true'>
            <path d='M9 12l2 2 4-4' />
          </svg>
          Active Since {LME.foundingYear}
        </span>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id='contact' class='mx-auto max-w-6xl px-4 pt-24 pb-20 md:px-6'>
    <p class='text-sm font-semibold tracking-wider uppercase text-brand mb-3'>
      Work with us
    </p>
    <h2 class='text-3xl font-bold text-white'>Ready to Start Your Project?</h2>
    <p class='mt-3 max-w-2xl text-neutral-400'>
      Whether you're submitting a tender, looking for a reliable subcontractor, or need
      a quote on construction or civil engineering work — we'd love to hear from you.
    </p>
    <div class='mt-8 flex flex-wrap gap-4'>
      <a
        href='/services'
        class='rounded-lg bg-accent px-6 py-3 font-semibold text-charcoal transition-colors hover:bg-accent-hover'
      >
        View our services
      </a>
      <a
        href={`tel:${LME.phoneTel}`}
        class='rounded-lg border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10'
      >
        Call {LME.phone}
      </a>
      <a
        href={`mailto:${LME.email}`}
        class='rounded-lg border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10'
      >
        Email us
      </a>
    </div>
  </section>
</LmeLayout>
