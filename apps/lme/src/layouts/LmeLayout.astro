---
import "@/styles/lme.css";
import BaseLayout from "@repo/tailwind/layouts/BaseLayout.astro";
import FloatingCallButton from "@/components/FloatingCallButton.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import LocalBusinessSchema from "@/components/LocalBusinessSchema.astro";
import { LME, formatBusinessHours } from "@/data/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "", ogImage } = Astro.props;
const hours = formatBusinessHours();

const navLinks = [
  { href: "#services", label: "Services" },
  { href: "#fleet", label: "Fleet" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<BaseLayout {title} {description} {ogImage} canonical={Astro.url.href} themeColor="#060810" bodyClass="bg-bg text-ink">
  <LocalBusinessSchema slot="head" />
  <Fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/lme-logo.png" type="image/png" sizes="68x68" />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Jost:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <slot name="head" slot="head" />

  {/* Skip to content */}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-brand focus:px-4 focus:py-2 focus:text-ink focus:outline-none">
    Skip to content
  </a>

  {/* Industrial corner treatment — a single hazard-stripe accent bar, not STP's hairline brackets */}
  <div class="pointer-events-none fixed top-0 left-0 z-40 h-2 w-24 origin-top-left -rotate-45 bg-accent max-sm:w-16"></div>

  {/* Blueprint grid — fine technical-drafting grid lines instead of the shared grain texture */}
  <div
    class="pointer-events-none fixed inset-0 z-0 opacity-[0.06]"
    style="background-image: linear-gradient(color-mix(in srgb, var(--color-brand) 80%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-brand) 80%, transparent) 1px, transparent 1px); background-size: 40px 40px;"
  >
  </div>

  <header class="sticky top-0 z-30 border-b-2 border-accent bg-bg/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
      <a href="/" class="flex shrink-0 items-center">
        <img src="/lme-logo.png" alt="Livhu and Musa Enterprise" class="h-10 w-10 rounded-lg bg-ink/15 p-1.5" />
      </a>

      {/* Desktop nav */}
      <nav class="hidden items-center gap-1 font-sans text-xs tracking-wide md:flex" aria-label="Main">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.href}
            class="group relative px-3 py-2 text-ink/60 uppercase transition-colors hover:text-brand"
          >
            {link.label}
            <span class="absolute inset-x-3 bottom-1 h-px scale-x-0 bg-accent transition-transform group-hover:scale-x-100"></span>
          </a>
        ))}
      </nav>

      {/* Desktop CTAs */}
      <div class="hidden items-center gap-2 md:flex">
        <a href={`tel:${LME.phoneTel}`} class="rounded-none bg-brand px-3 py-1.5 font-sans text-xs font-medium tracking-wide text-ink uppercase transition-colors hover:bg-brand-hover">
          Call now
        </a>
      </div>

      {/* Mobile hamburger */}
      <button type="button" id="nav-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-none text-ink/60 transition-colors hover:bg-ink/5 hover:text-ink md:hidden"
        aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path id="nav-icon-open" d="M4 6h16M4 12h16M4 18h16" />
          <path id="nav-icon-close" class="hidden" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="mobile-nav" class="absolute left-0 right-0 top-full z-40 md:hidden">
      <nav class="border-t border-ink/10 bg-bg px-4 pb-4 pt-2" aria-label="Mobile navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.href}
            class="block rounded-lg px-3 py-2.5 font-sans text-xs font-medium tracking-wide text-ink/60 uppercase transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="border-t border-ink/10 bg-bg px-4 pb-4 pt-3">
        <a href={`tel:${LME.phoneTel}`} class="block rounded-none bg-brand px-3 py-2.5 text-center font-sans text-xs font-medium tracking-wide text-ink uppercase transition-colors hover:bg-brand-hover">
          Call {LME.phone}
        </a>
      </div>
    </div>
  </header>

  <style>
    #mobile-nav {
      opacity: 0;
      transform: translateY(-100%);
      visibility: hidden;
      transition: opacity 300ms ease-in-out, transform 300ms ease-in-out, visibility 0s 300ms;
      will-change: transform, opacity;
    }
    #mobile-nav.open {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      transition: opacity 300ms ease-in-out, transform 300ms ease-in-out, visibility 0s;
    }
    [data-nav-link].is-active {
      color: var(--color-brand);
      font-weight: 500;
    }
  </style>

  <script>
    const navAnchors = document.querySelectorAll("[data-nav-link]");
    const sections = Array.from(navAnchors)
      .map((a) => a.getAttribute("data-nav-link"))
      .filter((href): href is string => !!href && href.includes("#"))
      .map((href) => document.querySelector(href.slice(href.indexOf("#"))))
      .filter((el): el is HTMLElement => el !== null);

    function setActiveLink(id: string) {
      navAnchors.forEach((a) => {
        const href = a.getAttribute("data-nav-link") ?? "";
        const fragment = href.includes("#") ? href.slice(href.indexOf("#")) : "";
        a.classList.toggle("is-active", fragment === `#${id}`);
      });
    }

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActiveLink(entry.target.id);
          }
        },
        { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
      );
      sections.forEach((section) => observer.observe(section));
    }

    // Mobile nav toggle
    const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
    const panel = document.getElementById("mobile-nav");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");

    function closeMenu() {
      panel?.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }

    toggle?.addEventListener("click", () => {
      const isOpen = panel?.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      iconOpen?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
    });

    panel?.addEventListener("click", (e) => {
      const link = (e.target as Element)?.closest("a");
      if (link && panel.classList.contains("open")) {
        closeMenu();
      }
    });
  </script>

  <main id="main-content" class="relative z-10">
    <slot />
  </main>

  <footer class="relative z-10 border-t-2 border-accent bg-bg-elevated py-12 pb-24 md:pb-12">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="grid gap-6 md:grid-cols-3">
        <div class="border-l-4 border-brand/60 pl-4 text-sm text-ink/60">
          <p class="flex items-center gap-2 font-semibold text-ink">
            <img src="/lme-logo.png" alt="" class="h-6 w-6 rounded bg-ink/10 p-0.5" />
            {LME.name}
          </p>
          <p class="mt-2">Serving {LME.serviceArea}</p>
          <p class="mt-1">{hours}</p>
          <p class="mt-4 space-y-1">
            <span class="block">
              <a href={`tel:${LME.phoneTel}`} class="text-brand hover:underline">{LME.phone}</a>
            </span>
            <span class="block">
              <a href={`mailto:${LME.email}`} class="text-brand hover:underline">{LME.email}</a>
            </span>
          </p>
        </div>
        <div class="border-l-4 border-accent/60 pl-4 text-sm text-ink/60">
          <p class="font-semibold text-ink">Address</p>
          <p class="mt-2">{LME.address.street}</p>
          <p>{LME.address.suburb}</p>
          <p>{LME.address.city}, {LME.address.province}</p>
          <a href={LME.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-xs text-brand hover:underline">
            Open in Google Maps →
          </a>
        </div>
        <div class="border-l-4 border-brand/60 pl-4 text-sm text-ink/60">
          <p class="font-semibold text-ink">Services</p>
          <ul class="mt-2 space-y-1 font-sans">
            <li><span class="text-accent">01</span> Civil Engineering (CE)</li>
            <li><span class="text-accent">02</span> General Building (GB)</li>
            <li><span class="text-accent">03</span> Electrical Engineering (EP)</li>
          </ul>
        </div>
      </div>
      <p class="mt-8 border-t border-ink/10 pt-6 font-sans text-[0.65rem] tracking-[0.25em] text-ink/30 uppercase">
        Level 1 B-BBEE &middot; CIDB CE, GB, EP &middot; Centurion, South Africa &middot; Est. {LME.foundingYear}
      </p>
    </div>
  </footer>

  <FloatingCallButton />
  <StickyMobileBar />
</BaseLayout>
