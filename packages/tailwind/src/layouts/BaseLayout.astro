---
// styles.css is intentionally NOT imported here — every consuming app
// imports its own themed CSS file (which itself imports styles.css and
// overrides the per-site tokens) before rendering this layout. Importing
// it again here would emit a second, un-overridden @theme block that wins
// the cascade and nulls out every site's colors/fonts.

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  canonical?: string;
  themeColor?: string;
}

const { title, description = "", bodyClass = "", ogImage, canonical, themeColor = "#000000" } = Astro.props;
// TODO: Create /og-image.svg in public/ (1200×630px) for social sharing

const imageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="en-ZA" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {title && <meta property="og:title" content={title} />}
    {description && <meta property="og:description" content={description} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <meta name="theme-color" content={themeColor} />
    <slot name="head" />
  </head>
  <body class:list={["min-h-screen font-sans antialiased scroll-pb-16", bodyClass]}>
    <slot />
  </body>
</html>
